# === Starstuck Lab .gitignore ===
# Keeps chaos (and node_modules) from consuming your repo.

# Node / Astro / JS build output
node_modules/
.astro/
.vercel/
.netlify/
.cache/
dist/
.output/

# Logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp

# Environment and config
.env
.env.*
.DS_Store

# Editor cruft
.vscode/
.idea/
*.swp
*.swo

# OS metadata
Thumbs.db

# Python tools or misc
__pycache__/
*.pyc
tools/__pycache__/

# Ignore site environment file
.env