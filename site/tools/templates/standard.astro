---
// site/tools/templates/standard.astro
// Template for creating standard content pages
import StandardPageLayout from '../layouts/StandardPageLayout.astro';
---

<StandardPageLayout 
  title="{{PAGE_TITLE}}"
  description="{{PAGE_TITLE}} page"
  pageClass="standard-page"
>
  <div class="standard-page">
    <div class="standard-page-inner">
      <h1>{{PAGE_TITLE}}</h1>
      
      <section>
        <h2>About</h2>
        <p>
          Add your content here.
        </p>
      </section>
      
      <section>
        <h2>Details</h2>
        <p>
          More content goes here.
        </p>
      </section>
    </div>
  </div>
</StandardPageLayout>