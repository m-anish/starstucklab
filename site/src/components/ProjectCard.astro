---
// site/src/components/ProjectCard.astro
// Similar to ProductCard but for project showcase items
import '../styles/components/parchment.css';

interface Props {
  project: {
    id: string;
    slug: string;
    title: string;
    excerpt: string;
    category?: string;
    status?: string;
    tags?: string[];
    image?: string;
    image_fallback?: string;
    url?: string;
  };
}

const { project } = Astro.props;

const heroImage = project.image || `/assets/projects/${project.slug}/hero.webp`;
const fallbackImage = project.image_fallback || `/assets/projects/${project.slug}/master.png`;
const projectUrl = project.url || `/projects/${project.slug}`;
---

<article class="project-card">
  <a href={projectUrl} class="project-link">
    <div class="project-image-wrap">
      <img 
        src={heroImage}
        alt={project.title}
        class="project-image"
        loading="lazy"
        onerror={`this.onerror=null;this.src='${fallbackImage}'`}
      />
      {project.status && (
        <span class={`project-status status-${project.status}`}>
          {project.status}
        </span>
      )}
    </div>
    
    <div class="parchment parchment--compact project-info">
      {project.category && (
        <span class="project-category">{project.category}</span>
      )}
      
      <h3 class="project-title">{project.title}</h3>
      
      <p class="project-excerpt">{project.excerpt}</p>
      
      {project.tags && project.tags.length > 0 && (
        <div class="project-tags">
          {project.tags.slice(0, 3).map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .project-card {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
  }
  
  .project-link {
    display: block;
    text-decoration: none;
    transition: transform var(--transition-base);
  }
  
  .project-link:hover {
    transform: translateY(-4px);
  }
  
  .project-link:active {
    transform: translateY(-1px);
  }
  
  .project-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    background: linear-gradient(135deg, #2a1d12 0%, #1a120a 100%);
  }
  
  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }
  
  .project-link:hover .project-image {
    transform: scale(1.05);
  }
  
  .project-status {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(0, 0, 0, 0.75);
    color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
  }
  
  .status-completed { border-left: 3px solid #4ec57a; }
  .status-ongoing { border-left: 3px solid #f0b429; }
  .status-experimental { border-left: 3px solid #8b9dc3; }
  .status-abandoned { border-left: 3px solid #a66; }
  .status-dormant { border-left: 3px solid #888; }
  
  .project-info {
    border-radius: 0 0 12px 12px;
    padding: var(--space-5) var(--space-4);
  }
  
  .project-category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--parchment-italic);
    margin-bottom: var(--space-2);
  }
  
  .project-title {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--parchment-heading);
    margin: 0 0 var(--space-3) 0;
    line-height: 1.3;
  }
  
  .project-excerpt {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--parchment-text);
    margin-bottom: var(--space-3);
    font-weight: 400;
  }
  
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  
  .project-tags .tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
  }
  
  @media (max-width: 640px) {
    .project-card {
      max-width: 100%;
    }
    
    .project-info {
      padding: var(--space-4) var(--space-3);
    }
  }
</style>