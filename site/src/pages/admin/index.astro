---
// site/src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/components/admin-dashboard.css';
---

<AdminLayout title="Dashboard">
  <div class="dashboard-grid">
    <!-- Quick Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <h3>📦 Products</h3>
        <div class="stat-value" id="product-count">Loading...</div>
        <p>Total products in catalog</p>
      </div>

      <div class="stat-card">
        <h3>🎨 Assets</h3>
        <div class="stat-value" id="asset-count">Loading...</div>
        <p>Images and media files</p>
      </div>

      <div class="stat-card">
        <h3>⚙️ Config</h3>
        <div class="stat-value">
          <span class="status-success" id="config-status">Checking...</span>
        </div>
        <p>Configuration health</p>
      </div>

      <div class="stat-card">
        <h3>🚀 CLI</h3>
        <div class="stat-value">
          <span class="status-success" id="cli-status">Available</span>
        </div>
        <p>Command line tools</p>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="activity-section">
      <h2>Recent Activity</h2>
      <div class="activity-list" id="recent-activity">
        <div class="activity-item">
          <span class="activity-time">Just now</span>
          <span class="activity-desc">Admin interface loaded</span>
        </div>
        <div class="activity-item">
          <span class="activity-time">Loading...</span>
          <span class="activity-desc">Loading dashboard data...</span>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="actions-section">
      <h2>Quick Actions</h2>
      <div class="action-buttons">
        <a href="/admin/products/new" class="btn btn-primary">
          ➕ Create Product
        </a>
        <button class="btn btn-secondary" onclick="optimizeAssets()">
          🔧 Optimize Assets
        </button>
        <button class="btn btn-secondary" onclick="generateLogos()">
          🎨 Generate Logos
        </button>
        <a href="/admin/config" class="btn btn-secondary">
          ⚙️ Check Config
        </a>
      </div>
    </div>
  </div>
</AdminLayout>



<script is:inline>
  // Load dashboard data
  async function loadDashboardData() {
    try {
      // Load product count
      const productsResponse = await fetch('/api/cli/products/list.json');
      const productsData = await productsResponse.json();

      const productCountEl = document.getElementById('product-count');
      if (productCountEl && productsData.success && productsData.data) {
        productCountEl.textContent = productsData.data.length.toString();
      }

      // Load config health
      const configResponse = await fetch('/api/cli/config/health');
      const configData = await configResponse.json();

      const configStatusEl = document.getElementById('config-status');
      if (configStatusEl) {
        if (configData.success && configData.healthy) {
          configStatusEl.textContent = 'Healthy';
          configStatusEl.className = 'status-success';
        } else {
          configStatusEl.textContent = 'Issues';
          configStatusEl.className = 'status-error';
        }
      }

      // Load asset info (placeholder for now)
      const assetCountEl = document.getElementById('asset-count');
      if (assetCountEl) {
        assetCountEl.textContent = '35+';
      }

      // Add to recent activity
      addActivityItem('Dashboard data loaded successfully');
      addActivityItem('CLI tools verified and available');

    } catch (error) {
      console.error('Failed to load dashboard data:', error);
      addActivityItem('Error loading dashboard data', 'error');
    }
  }

  // Quick action functions
  async function optimizeAssets(event) {
    const button = event.target;
    if (!button) return;

    const originalText = button.textContent || '';

    try {
      button.textContent = 'Optimizing...';
      button.classList.add('loading');

      const response = await fetch('/api/cli/assets/optimize', {
        method: 'POST'
      });

      const result = await response.json();

      if (result.success) {
        addActivityItem(`Optimized ${result.totalOptimized || 0} assets`);
        if (window.AdminUtils) {
          window.AdminUtils.showNotification('Assets optimized successfully!', 'success');
        }
      } else {
        throw new Error(result.error);
      }

    } catch (error) {
      if (window.AdminUtils) {
        window.AdminUtils.showNotification('Asset optimization failed', 'error');
      }
      addActivityItem('Asset optimization failed', 'error');
    } finally {
      button.textContent = originalText;
      button.classList.remove('loading');
    }
  }

  async function generateLogos(event) {
    const button = event.target;
    if (!button) return;

    const originalText = button.textContent || '';

    try {
      button.textContent = 'Generating...';
      button.classList.add('loading');

      const response = await fetch('/api/cli/assets/logos', {
        method: 'POST'
      });

      const result = await response.json();

      if (result.success) {
        addActivityItem('Logo variants generated successfully');
        if (window.AdminUtils) {
          window.AdminUtils.showNotification('Logo variants generated!', 'success');
        }
      } else {
        throw new Error(result.error);
      }

    } catch (error) {
      if (window.AdminUtils) {
        window.AdminUtils.showNotification('Logo generation failed', 'error');
      }
      addActivityItem('Logo generation failed', 'error');
    } finally {
      button.textContent = originalText;
      button.classList.remove('loading');
    }
  }

  function addActivityItem(description, type = 'info') {
    const activityList = document.getElementById('recent-activity');
    if (!activityList) return;

    const item = document.createElement('div');
    item.className = 'activity-item';

    const time = new Date().toLocaleTimeString();
    item.innerHTML = `
      <span class="activity-time">${time}</span>
      <span class="activity-desc">${description}</span>
    `;

    // Insert at the top
    const firstChild = activityList.firstChild;
    if (firstChild) {
      activityList.insertBefore(item, firstChild);
    } else {
      activityList.appendChild(item);
    }

    // Keep only last 10 items
    while (activityList.children.length > 10) {
      const lastChild = activityList.lastChild;
      if (lastChild) {
        activityList.removeChild(lastChild);
      }
    }
  }

  // Initialize dashboard
  document.addEventListener('DOMContentLoaded', loadDashboardData);
</script>
