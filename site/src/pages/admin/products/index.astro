---
// site/src/pages/admin/products/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/components/admin-products.css';
---

<AdminLayout title="Products">
  <div class="products-section">
    <!-- Header Actions -->
    <div class="section-header">
      <div class="header-info">
        <h2>Product Catalog</h2>
        <p>Manage your Starstuck Lab products</p>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary" onclick="refreshProducts()">
          🔄 Refresh
        </button>
        <a href="/admin/products/new" class="btn btn-primary">
          ➕ New Product
        </a>
      </div>
    </div>

    <!-- Products Table -->
    <div class="products-table-container">
      <table class="products-table" id="products-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Slug</th>
            <th>Title</th>
            <th>Price</th>
            <th>Tags</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="products-tbody">
          <tr>
            <td colspan="6" class="loading-row">
              <div class="loading-spinner"></div>
              Loading products...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Quick Stats -->
    <div class="products-stats">
      <div class="stat-item">
        <span class="stat-label">Total Products:</span>
        <span class="stat-value" id="total-products">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Available:</span>
        <span class="stat-value status-success" id="available-products">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Coming Soon:</span>
        <span class="stat-value status-warning" id="coming-soon-products">0</span>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .products-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .header-info h2 {
    margin: 0 0 0.5rem 0;
    color: var(--admin-accent);
  }

  .header-info p {
    margin: 0;
    color: var(--admin-text-secondary);
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .products-table-container {
    background: var(--admin-surface);
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .products-table {
    width: 100%;
    border-collapse: collapse;
  }

  .products-table th,
  .products-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--admin-border);
  }

  .products-table th {
    background: var(--admin-surface);
    color: var(--admin-accent);
    font-weight: 600;
    position: sticky;
    top: 0;
  }

  .products-table tbody tr:hover {
    background: rgba(0, 212, 255, 0.05);
  }

  .loading-row {
    text-align: center;
    color: var(--admin-text-secondary);
    padding: 3rem;
  }

  .loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid var(--admin-border);
    border-radius: 50%;
    border-top-color: var(--admin-accent);
    animation: spin 1s linear infinite;
    margin-right: 0.5rem;
  }

  .status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .status-available {
    background: rgba(0, 255, 136, 0.2);
    color: var(--admin-success);
  }

  .status-coming_soon {
    background: rgba(255, 170, 0, 0.2);
    color: var(--admin-warning);
  }

  .status-unavailable {
    background: rgba(255, 68, 68, 0.2);
    color: var(--admin-error);
  }

  .status-discontinued {
    background: rgba(128, 128, 128, 0.2);
    color: #888;
  }

  .price-cell {
    font-weight: 600;
    color: var(--admin-accent);
  }

  .tags-cell {
    max-width: 200px;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tag {
    background: var(--admin-border);
    color: var(--admin-text-secondary);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .actions-cell {
    white-space: nowrap;
  }

  .action-btn {
    padding: 0.25rem 0.5rem;
    margin-right: 0.5rem;
    border: 1px solid var(--admin-border);
    background: transparent;
    color: var(--admin-text-secondary);
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: var(--admin-border);
    color: var(--admin-text);
  }

  .action-btn.edit:hover {
    background: var(--admin-accent);
    color: var(--admin-bg);
    border-color: var(--admin-accent);
  }

  .products-stats {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--admin-surface);
    border: 1px solid var(--admin-border);
    border-radius: 8px;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-label {
    color: var(--admin-text-secondary);
  }

  .stat-value {
    font-weight: 600;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      gap: 1rem;
    }

    .products-table {
      font-size: 0.9rem;
    }

    .products-table th,
    .products-table td {
      padding: 0.5rem;
    }

    .products-stats {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script is:inline>
  let productsData = [];

  // Load products data
  async function loadProducts() {
    try {
      const response = await fetch('/api/cli/products/list.json');
      const data = await response.json();

      if (data.success && data.data) {
        productsData = data.data;
        renderProducts(productsData);
        updateStats(productsData);
      } else {
        showError('Failed to load products');
      }
    } catch (error) {
      console.error('Error loading products:', error);
      showError('Error loading products');
    }
  }

  // Render products table
  function renderProducts(products) {
    const tbody = document.getElementById('products-tbody');
    if (!tbody) return;

    if (products.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="loading-row">
            No products found. <a href="/admin/products/new">Create your first product</a>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = products.map(product => `
      <tr>
        <td>
          <span class="status-badge status-${product.status || 'unavailable'}">
            ${formatStatus(product.status || 'unavailable')}
          </span>
        </td>
        <td><code>${product.slug}</code></td>
        <td>${product.title}</td>
        <td class="price-cell">${product.price ? formatPrice(product.price) : 'N/A'}</td>
        <td class="tags-cell">${renderTags(product.tags)}</td>
        <td class="actions-cell">
          <button class="action-btn edit" onclick="editProduct('${product.slug}')">
            ✏️ Edit
          </button>
          <button class="action-btn" onclick="viewProduct('${product.slug}')">
            👁️ View
          </button>
        </td>
      </tr>
    `).join('');
  }

  // Update statistics
  function updateStats(products) {
    const totalEl = document.getElementById('total-products');
    const availableEl = document.getElementById('available-products');
    const comingSoonEl = document.getElementById('coming-soon-products');

    if (totalEl) totalEl.textContent = products.length.toString();

    const available = products.filter(p => p.status === 'available').length;
    const comingSoon = products.filter(p => p.status === 'coming_soon').length;

    if (availableEl) availableEl.textContent = available.toString();
    if (comingSoonEl) comingSoonEl.textContent = comingSoon.toString();
  }

  // Helper functions
  function formatStatus(status) {
    return status.replace('_', ' ').toUpperCase();
  }

  function formatPrice(price) {
    return typeof price === 'string' ? price : `$${parseFloat(price).toFixed(2)}`;
  }

  function renderTags(tags) {
    if (!tags || !Array.isArray(tags) || tags.length === 0) {
      return '<span class="no-tags">No tags</span>';
    }
    return tags.map(tag => `<span class="tag">#${tag}</span>`).join(' ');
  }

  function showError(message) {
    const tbody = document.getElementById('products-tbody');
    if (tbody) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="loading-row" style="color: var(--admin-error);">
            ${message}
          </td>
        </tr>
      `;
    }
  }

  // Action handlers
  function refreshProducts() {
    const tbody = document.getElementById('products-tbody');
    if (tbody) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="loading-row">
            <div class="loading-spinner"></div>
            Refreshing...
          </td>
        </tr>
      `;
    }
    loadProducts();
  }

  function editProduct(slug) {
    window.location.href = `/admin/products/${slug}`;
  }

  function viewProduct(slug) {
    window.open(`/${slug}`, '_blank');
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', loadProducts);
</script>
