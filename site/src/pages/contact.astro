---
// site/src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import "../styles/components/contact.css";
---

<Layout title="Contact - Starstuck Lab">
  <div class="contact-page">
    <div class="contact-container">
      <div class="contact-header">
        <h1>Get In Touch</h1>
        <p class="contact-lead">
          Have a question, project idea, or just want to say hello? 
          We'd love to hear from you.
        </p>
      </div>

      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-card">
            <h3>📧 Email</h3>
            <p>
              <a href="mailto:your-email@domain.com">your-email@domain.com</a>
            </p>
          </div>

          <div class="info-card">
            <h3>⏱️ Response Time</h3>
            <p>We typically respond within 24-48 hours on business days.</p>
          </div>

          <div class="info-card">
            <h3>🌍 Location</h3>
            <p>Based in India, working with the universe.</p>
          </div>

          <div class="info-card">
            <h3>🔗 Connect</h3>
            <p>
              <!-- Add your social media links -->
              <a href="#" target="_blank" rel="noopener">Twitter</a> • 
              <a href="#" target="_blank" rel="noopener">GitHub</a> • 
              <a href="#" target="_blank" rel="noopener">Instagram</a>
            </p>
          </div>
        </div>

        <div class="contact-form-section">
          <ContactForm />
        </div>
      </div>

      <div class="contact-footer-note">
        <p>
          <strong>Note:</strong> We respect your privacy. Your information is only used to 
          respond to your inquiry and is never shared with third parties. 
          See our <a href="/privacy">Privacy Policy</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>