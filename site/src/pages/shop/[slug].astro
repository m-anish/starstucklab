---
// SPDX-License-Identifier: DWYWBDBM-1.0
// site/src/pages/shop/[slug].astro
import { getCollection } from 'astro:content';
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import "../../styles/tokens.css";
import "../../styles/components/parchment.css";
import "../../styles/components/standard-page.css";
import "../../styles/components/product-detail.css";

// Get all products from content collection
const allProducts = await getCollection('products');

// Build-time: tell Astro which slugs to pre-render
export async function getStaticPaths() {
  const products = await getCollection('products');

  if (products.length === 0) {
    console.warn('getStaticPaths: no product markdown files found');
  }

  return products.map(entry => ({
    params: { slug: entry.slug },
    props: { product: entry }
  }));
}

const { product } = Astro.props;
const slug = product.slug;

// Image paths
const heroImagePath = product.data.images?.master?.replace('public/', '/') || `/assets/product-${slug}/product-${slug}-hero.webp`;
const masterFallback = `/assets/product-${slug}/product-${slug}-master.png`;

// Extract what's included from markdown body (simplified approach)
// For now, we'll use a placeholder - in a real implementation,
// you'd parse the markdown body for sections
const whatsIncluded = ["Product details available in description"];
---
<StandardPageLayout title={product.data.title} backgroundScene="shop">
  <article class="product-container">
      <!-- Product image with vintage frame -->
      <div class="product-media">
        <img
          src={heroImagePath}
          alt={product.data.title}
          onerror={`this.onerror=null;this.src='${masterFallback}'`}
        />
      </div>

      <!-- Main product info card - uses base parchment -->
      <div class="parchment product-info-card">
        <h1>{product.data.title}</h1>

        <div class="product-meta-row">
          {product.data.price && (
            <span class="product-price">{product.data.currency || 'USD'} {product.data.price}</span>
          )}
          {product.data.status && (
            <span class="status">{product.data.status}</span>
          )}
        </div>

        {product.data.tags && product.data.tags.length > 0 && (
          <div class="tags-row">
            {product.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
          </div>
        )}

        <div class="product-description">
          <p>{product.data.excerpt}</p>
        </div>

        <!-- Placeholder for "What's Included" - would be parsed from markdown body -->
        <div class="parchment parchment--nested product-included">
          <h4>What's Included</h4>
          <ul class="included-list">
            {whatsIncluded.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <!-- Add to Cart Button -->
        <div class="product-actions">
          <AddToCartButton product={{
            slug: product.slug,
            title: product.data.title,
            price: product.data.price,
            currency: product.data.currency,
            status: product.data.status
          }} />
        </div>

        <!-- Generation metadata -->
        {product.data.date && (
          <div class="metadata">
            <span class="sparkle">✦</span> Added {new Date(product.data.date).toLocaleDateString()}
          </div>
        )}
    </article>
</StandardPageLayout>
