// site/src/layouts/StandardPageLayout.astro
// Standard layout for shop, contact, privacy, legal pages
// Includes: static navbar, content area, footer and optional scene background

import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/components/navbar.css";
import "../styles/components/footer.css";

import fs from 'fs';
import path from 'path';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  /** optional scene key to render a background picture from /assets manifest (e.g. "shop") */
  backgroundScene?: string;
}

const { title, description, pageClass = '', backgroundScene = '' } = Astro.props;

/** --- manifest helpers (lifted from shop.astro) --- */
const manifestPath = new URL('../data/images.json', import.meta.url);

const BASE_URL = String(import.meta.env.BASE_URL || '/') + 'assets/';

let images = {};
try {
  images = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
} catch (err) {
  // If manifest missing, keep images empty and render no picture
  console.warn(`Could not read images manifest at ${manifestPath.pathname}:`, err);
}

const SCENES = images.scenes || {};

function findVariantFilename(sceneKey, opts = {}) {
  const scene = SCENES[sceneKey];
  if (!scene || !Array.isArray(scene.variants)) return null;
  if (opts.id) {
    const byId = scene.variants.find(v => v.id === opts.id && v.filename);
    if (byId) return byId.filename;
  }
  if (opts.aspect) {
    const byAspect = scene.variants.find(v => v.aspect === opts.aspect && v.filename);
    if (byAspect) return byAspect.filename;
  }
  if (opts.type) {
    const byType = scene.variants.find(v => v.type === opts.type && v.filename);
    if (byType) return byType.filename;
  }
  return null;
}

function staticUrlFromManifest(sceneKey, manifestFilename) {
  if (!manifestFilename) return null;
  return path.posix.join(BASE_URL, sceneKey, manifestFilename);
}

function buildSceneSources(sceneKey) {
  const byId = id => findVariantFilename(sceneKey, { id });
  const filenames = {
    generated: byId('generated'),
    master: byId('master'),
    desktop: byId('desktop'),
    laptop: byId('laptop'),
    tablet: byId('tablet'),
    mobile: byId('mobile'),
    thumb: byId('thumb'),
  };
  const urls = {};
  for (const k in filenames) {
    const fname = filenames[k];
    urls[k] = fname ? staticUrlFromManifest(sceneKey, fname) : null;
  }
  return urls;
}

const DEFAULT_FALLBACK = `/assets/shop/shop-master.webp`;
const sceneSources = backgroundScene ? buildSceneSources(backgroundScene) : null;
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  <nav class="site-nav nav-static" role="navigation">
    <Navbar />
  </nav>

  <!-- Background stage (render only when a backgroundScene is present in the manifest) -->
  {sceneSources ? (
    <div class="page-stage page-stage--with-bg">
      <picture>
        {sceneSources.desktop ? <source media="(min-width:1000px)" srcset={sceneSources.desktop} /> : null}
        {sceneSources.tablet ? <source media="(min-width:640px)" srcset={sceneSources.tablet} /> : null}
        <img
          src={sceneSources.mobile ?? sceneSources.generated ?? sceneSources.thumb ?? sceneSources.desktop ?? DEFAULT_FALLBACK}
          alt="Background scene"
          class="page-bg"
          loading="eager"
        />
      </picture>

      <main class={`page-content ${pageClass} ${backgroundScene ? 'page-has-bg' : ''}`}>
        <slot />
      </main>
    </div>
  ) : (
    // If no scene requested / found, just render normal structure
    <main class={`page-content ${pageClass}`}>
      <slot />
    </main>
  )}

  <Footer />
</BaseLayout>

<style>
  .page-content {
    min-height: 100vh;
    padding-top: 64px; /* Account for fixed navbar */
    position: relative;
    z-index: 2;
  }

  .page-stage {
    position: relative;
    overflow: visible;
  }

  .page-stage--with-bg .page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  /* ensure content sits above bg */
  .page-stage--with-bg .page-content {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 820px) {
    .page-content {
      padding-top: 56px;
    }
  }
</style>
