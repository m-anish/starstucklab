{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "Hardware",
            "Software",
            "Art",
            "Science",
            "Electronics",
            "Mechanical",
            "Weather",
            "Telescope",
            "Other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ongoing",
            "completed",
            "experimental",
            "abandoned",
            "dormant"
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "excerpt": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "updated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "image": {
          "type": "string"
        },
        "image_alt": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "category",
        "status",
        "date",
        "excerpt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}