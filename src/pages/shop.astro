// site/src/pages/shop.astro
import { getCollection } from 'astro:content';
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import "../styles/components/parchment.css";
import "../styles/components/shop.css";

// Get all products from content collection
const allProducts = await getCollection('products');

// Sort by date descending (newest first)
const sortedProducts = allProducts
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

// Transform to ProductCard format
const products = sortedProducts.map(entry => ({
  id: entry.id,
  slug: entry.slug,
  title: entry.data.title,
  excerpt: entry.data.excerpt,
  price: entry.data.price,
  currency: entry.data.currency || 'USD',
  status: entry.data.status,
  tags: entry.data.tags || [],
  date: entry.data.date,
  images: entry.data.images,
  url: `/shop/${entry.slug}`
}));
---
<!-- Request the shared shop background by setting backgroundScene="shop" -->
<StandardPageLayout title="Shop — Starstuck Lab" pageClass="shop-page" backgroundScene="shop">
  <div class="shop-content">
    <header class="shop-hero">
      <h1>Shop — Artifacts from the Bench</h1>
      <p class="lead">Handmade, printed, lightly cursed. Pick something that will outlive your patience.</p>
    </header>

    {products.length === 0 ? (
      <div class="parchment parchment--centered no-products">
        <p>No products available yet. Check back soon!</p>
      </div>
    ) : (
      <section class="product-grid" role="list">
        {products.map(p => <ProductCard product={p} />)}
      </section>
    )}
  </div>
</StandardPageLayout>
