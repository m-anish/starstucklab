---
// shop.astro — V2: uses StandardPageLayout with workshop background for consistent styling
import { getCollection } from 'astro:content';
import StandardPageLayout from '../layouts/StandardPageLayout.astro';
import '../styles/components/standard-page.css';

const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => p.data.status === 'available')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatPrice(price: number, currency = 'INR'): string {
  if (currency === 'INR') return `₹${price.toLocaleString('en-IN')}`;
  return `${currency} ${price.toLocaleString()}`;
}
---
<StandardPageLayout
  title="Shop — Starstuck Lab"
  description="Handmade telescopes built to order in India. Two products. Both very good."
  backgroundScene="workshop"
>
  <main class="shop standard-page">
    <!-- Header -->
    <header class="shop__header standard-page-inner">
      <p class="shop__eyebrow">Shop</p>
      <h1>Hardware that mostly works.</h1>
      <p class="shop__subtitle">
        Two telescopes. Both built to order in a small workshop somewhere in
        India, where someone cares perhaps too much about collimation tolerances.
        Lead times depend on weather and mood.
      </p>
    </header>

    <!-- Product grid -->
    <section class="shop__grid-section standard-page-inner">
      {products.length === 0 ? (
        <p class="shop__empty">
          Nothing available right now. Check back shortly — or read the{' '}
          <a href="/lab">Lab Notes</a> while you wait.
        </p>
      ) : (
        <div class="shop__grid">
          {products.map((product) => {
            const { title, tagline, price, currency, stock_status, lead_time, images, excerpt } = product.data;
            const isBuildToOrder = stock_status === 'build_to_order';
            const isOutOfStock   = stock_status === 'out_of_stock';
            return (
              <a href={`/shop/${product.slug}`} class="pc">
                <div class="pc__image-wrap">
                  <span class="pc__gen-badge" aria-hidden="true">✦ generated</span>
                  {images?.master ? (
                    <img
                      src={images.master}
                      alt={title}
                      class="pc__image"
                      loading="lazy"
                    />
                  ) : (
                    <div class="pc__placeholder" aria-hidden="true">✦</div>
                  )}
                </div>
                <div class="pc__body">
                  <div class="pc__badges">
                    {isBuildToOrder && <span class="pc__badge">Build to Order</span>}
                    {isOutOfStock   && <span class="pc__badge pc__badge--out">Out of Stock</span>}
                  </div>
                  <h2 class="pc__title">{title}</h2>
                  {tagline && <p class="pc__tagline">{tagline}</p>}
                  <p class="pc__excerpt">{excerpt}</p>
                  <div class="pc__footer">
                    {price && (
                      <span class="pc__price">{formatPrice(price, currency)}</span>
                    )}
                    {isBuildToOrder && lead_time && (
                      <span class="pc__lead">Ships in {lead_time}</span>
                    )}
                    <span class="pc__arrow">View Details →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </main>
</StandardPageLayout>

<style>
  /* ── Shop header ── */
  .shop__header {
    padding-top: var(--space-16, 4rem);
    padding-bottom: var(--space-10, 2.5rem);
    text-align: center;
  }

  .shop__eyebrow {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(248, 244, 232, 0.55);
    margin: 0 0 var(--space-4, 1rem);
    font-weight: 600;
  }

  .shop__subtitle {
    max-width: 52ch;
    margin-inline: auto;
    color: rgba(245, 230, 200, 0.65);
    font-size: var(--text-base, 1rem);
    line-height: var(--leading-base, 1.6);
    font-style: italic;
  }

  /* ── Grid ── */
  .shop__grid-section {
    padding-top: var(--space-6, 1.5rem);
    padding-bottom: var(--space-24, 6rem);
  }

  .shop__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-8, 2rem);
  }

  .shop__empty {
    text-align: center;
    color: rgba(245, 230, 200, 0.6);
    padding: var(--space-20, 5rem) 0;
  }

  .shop__empty a {
    color: var(--color-accent, #4ec57a);
  }

  /* ══════════════════════
     PARCHMENT PRODUCT CARD
  ══════════════════════ */
  .pc {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--color-parchment-dim, #f4dab8);
    border: 1px solid var(--color-parchment-dark, rgba(120,80,30,0.3));
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    box-shadow: 0 4px 32px rgba(0,0,0,0.5), 0 1px 0 rgba(255,255,255,0.04) inset;
    transition: transform var(--transition-base, 0.25s ease), box-shadow var(--transition-base, 0.25s ease);
  }

  .pc:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(0,0,0,0.65);
  }

  .pc__image-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(0,0,0,0.06);
    position: relative;
  }

  .pc__gen-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.78);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 5px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .pc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 0.4s ease);
  }

  .pc:hover .pc__image { transform: scale(1.04); }

  .pc__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--color-parchment-muted, rgba(80,50,20,0.4));
  }

  .pc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6, 1.5rem);
  }

  .pc__badges {
    display: flex;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-3, 0.75rem);
    min-height: 1.5rem;
  }

  .pc__badge {
    display: inline-block;
    font-family: var(--font-sans, system-ui);
    font-size: var(--text-xs, 0.75rem);
    font-weight: var(--weight-semibold, 600);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-price-green, #1d5a3d);
    background: rgba(45, 106, 79, 0.12);
    border: 1px solid rgba(45, 106, 79, 0.3);
    border-radius: var(--radius-full, 100px);
    padding: 2px 10px;
  }

  .pc__badge--out {
    color: var(--color-danger, #c0392b);
    background: rgba(192, 57, 43, 0.1);
    border-color: rgba(192, 57, 43, 0.3);
  }

  .pc__title {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 700;
    color: var(--color-parchment-text, #2a1d12);
    margin-bottom: var(--space-2, 0.5rem);
    line-height: var(--leading-tight, 1.25);
  }

  .pc__tagline {
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-parchment-muted, rgba(80,50,20,0.7));
    font-style: italic;
    line-height: var(--leading-base, 1.6);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .pc__excerpt {
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-parchment-muted, rgba(80,50,20,0.7));
    line-height: var(--leading-base, 1.6);
    flex: 1;
    margin-bottom: var(--space-5, 1.25rem);
  }

  .pc__footer {
    display: flex;
    align-items: baseline;
    gap: var(--space-3, 0.75rem);
    flex-wrap: wrap;
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid var(--color-parchment-dark, rgba(120,80,30,0.2));
  }

  .pc__price {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 700;
    color: var(--color-price-green, #1d5a3d);
    flex: 1;
  }

  .pc__lead {
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-parchment-muted, rgba(80,50,20,0.7));
  }

  .pc__arrow {
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--weight-semibold, 600);
    color: var(--color-parchment-muted, rgba(80,50,20,0.7));
    transition: color var(--transition-fast, 0.15s ease);
  }

  .pc:hover .pc__arrow { color: var(--color-parchment-text, #2a1d12); }

  @media (max-width: 480px) {
    .shop__grid { grid-template-columns: 1fr; }
  }
</style>
