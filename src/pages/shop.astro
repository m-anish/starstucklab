---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const allProducts = await getCollection('products');
const products = allProducts
  .filter((p) => p.data.status === 'available')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatPrice(price: number, currency = 'INR'): string {
  if (currency === 'INR') return `₹${price.toLocaleString('en-IN')}`;
  return `${currency} ${price.toLocaleString()}`;
}
---
<PageLayout
  title="Shop — Starstuck Lab"
  description="Handmade telescopes built to order in India. Two products. Both very good."
  padTop={false}
>
  <!-- Scene background -->
  <div class="shop-bg" aria-hidden="true">
    <picture>
      <source srcset="/assets/hero/workshop-wide.webp" />
      <img
        src="/assets/hero/hero-master.webp"
        alt=""
        class="shop-bg__img"
        loading="eager"
      />
    </picture>
    <div class="shop-bg__overlay"></div>
  </div>

  <main class="shop">
    <!-- Header -->
    <header class="shop__header">
      <div class="container">
        <p class="shop__eyebrow">Workshop</p>
        <h1 class="shop__title">Available Now</h1>
        <p class="shop__subtitle">
          Two products. Both telescopes. Both hand-built to order in a small
          workshop somewhere in India, by one person who cares perhaps too much
          about collimation tolerances.
        </p>
      </div>
    </header>

    <!-- Product grid -->
    <section class="shop__grid-section container">
      {products.length === 0 ? (
        <p class="shop__empty">
          Nothing available right now. Check back shortly — or read the{' '}
          <a href="/lab">Lab Notes</a> while you wait.
        </p>
      ) : (
        <div class="shop__grid">
          {products.map((product) => {
            const { title, tagline, price, currency, stock_status, lead_time, images, excerpt } = product.data;
            const isBuildToOrder = stock_status === 'build_to_order';
            const isOutOfStock   = stock_status === 'out_of_stock';
            return (
              <a href={`/shop/${product.slug}`} class="pc">
                <div class="pc__image-wrap">
                  {images?.master ? (
                    <img
                      src={images.master}
                      alt={title}
                      class="pc__image"
                      loading="lazy"
                    />
                  ) : (
                    <div class="pc__placeholder" aria-hidden="true">✦</div>
                  )}
                </div>
                <div class="pc__body">
                  <div class="pc__badges">
                    {isBuildToOrder && <span class="pc__badge">Build to Order</span>}
                    {isOutOfStock   && <span class="pc__badge pc__badge--out">Out of Stock</span>}
                  </div>
                  <h2 class="pc__title">{title}</h2>
                  {tagline && <p class="pc__tagline">{tagline}</p>}
                  <p class="pc__excerpt">{excerpt}</p>
                  <div class="pc__footer">
                    {price && (
                      <span class="pc__price">{formatPrice(price, currency)}</span>
                    )}
                    {isBuildToOrder && lead_time && (
                      <span class="pc__lead">Ships in {lead_time}</span>
                    )}
                    <span class="pc__arrow">View Details →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </main>
</PageLayout>

<style>
  /* ── Scene background (absolutely positioned under content) ── */
  .shop-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .shop-bg__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .shop-bg__overlay {
    position: absolute;
    inset: 0;
    background: rgba(6, 4, 2, 0.78);
  }

  /* ── Main content above bg ── */
  .shop {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    padding-top: var(--navbar-height);
    padding-bottom: var(--space-24);
  }

  /* ── Header ── */
  .shop__header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-10);
    text-align: center;
  }

  .shop__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .shop__title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-parchment);
    text-shadow: 0 2px 16px rgba(0,0,0,0.6);
    margin-bottom: var(--space-4);
  }

  .shop__subtitle {
    max-width: 52ch;
    margin-inline: auto;
    color: rgba(245, 230, 200, 0.6);
    font-size: var(--text-base);
    line-height: var(--leading-base);
    font-style: italic;
  }

  /* ── Grid ── */
  .shop__grid-section {
    padding-top: var(--space-6);
  }

  .shop__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-8);
  }

  .shop__empty {
    text-align: center;
    color: rgba(245, 230, 200, 0.6);
    padding: var(--space-20) 0;
  }

  .shop__empty a {
    color: var(--color-accent);
  }

  /* ══════════════════════
     PARCHMENT PRODUCT CARD
  ══════════════════════ */
  .pc {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--color-parchment-dim);
    border: 1px solid var(--color-parchment-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 32px rgba(0,0,0,0.5), 0 1px 0 rgba(255,255,255,0.04) inset;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .pc:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(0,0,0,0.65);
  }

  .pc__image-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(0,0,0,0.06);
  }

  .pc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .pc:hover .pc__image { transform: scale(1.04); }

  .pc__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--color-parchment-muted);
  }

  .pc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }

  .pc__badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    min-height: 1.5rem;
  }

  .pc__badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-price-green);
    background: rgba(45, 106, 79, 0.12);
    border: 1px solid rgba(45, 106, 79, 0.3);
    border-radius: var(--radius-full);
    padding: 2px 10px;
  }

  .pc__badge--out {
    color: var(--color-danger);
    background: rgba(192, 57, 43, 0.1);
    border-color: rgba(192, 57, 43, 0.3);
  }

  .pc__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-parchment-text);
    margin-bottom: var(--space-2);
    line-height: var(--leading-tight);
  }

  .pc__tagline {
    font-size: var(--text-sm);
    color: var(--color-parchment-muted);
    font-style: italic;
    line-height: var(--leading-base);
    margin-bottom: var(--space-3);
  }

  .pc__excerpt {
    font-size: var(--text-sm);
    color: var(--color-parchment-muted);
    line-height: var(--leading-base);
    flex: 1;
    margin-bottom: var(--space-5);
  }

  .pc__footer {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-parchment-dark);
  }

  .pc__price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-price-green);
    flex: 1;
  }

  .pc__lead {
    font-size: var(--text-xs);
    color: var(--color-parchment-muted);
  }

  .pc__arrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-parchment-muted);
    transition: color var(--transition-fast);
  }

  .pc:hover .pc__arrow { color: var(--color-parchment-text); }

  @media (max-width: 480px) {
    .shop__grid { grid-template-columns: 1fr; }
  }
</style>
