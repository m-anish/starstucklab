---
// contact.astro — V1 visual restoration: StandardPageLayout with workshop background
import StandardPageLayout from '../layouts/StandardPageLayout.astro';
import '../styles/components/standard-page.css';
import '../styles/components/contact.css';
---
<StandardPageLayout
  title="Contact — Starstuck Lab"
  description="Get in touch about orders, custom requests, or existential queries."
  pageClass="standard-page"
  backgroundScene="shop"
>
  <div class="contact-page">
    <div class="contact-container">
      <div class="contact-header">
        <h1>Get In Touch</h1>
        <p class="contact-lead">
          For orders, custom builds, shipping questions, warranty inquiries,
          or if you just want to tell us what you saw last night.
        </p>
      </div>

      <div class="contact-grid">
        <div class="contact-info">
          <div class="info-card">
            <h3>📧 Email</h3>
            <p>
              <a href="mailto:hello@starstucklab.com">hello@starstucklab.com</a>
            </p>
          </div>

          <div class="info-card">
            <h3>⏱️ Response Time</h3>
            <p>
              Usually within 24 hours, occasionally within a week,
              never more than the thermal equilibration time of a planetary atmosphere.
            </p>
          </div>

          <div class="info-card">
            <h3>🔭 Custom Orders</h3>
            <p>
              All telescopes are built to order. Reach out before placing an order
              if you have specific requirements or modifications in mind.
            </p>
          </div>
        </div>

        <div class="contact-form-section">
          <form id="contact-form" novalidate>
            <div class="form-field">
              <label for="name">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
              />
            </div>

            <div class="form-field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
              />
            </div>

            <div class="form-field">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows={6}
                required
                placeholder="What's on your mind?"
              ></textarea>
            </div>

            <div id="form-status" class="form-status" hidden></div>

            <button type="submit" id="submit-btn" class="cta-btn">
              Send Message
            </button>
          </form>
        </div>
      </div>

      <div class="contact-footer-note">
        <p>
          Alternatively, email directly at
          <a href="mailto:hello@starstucklab.com">hello@starstucklab.com</a>.
          We're a one-person workshop — your patience is appreciated.
        </p>
      </div>
    </div>
  </div>
</StandardPageLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status') as HTMLElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showStatus(message: string, type: 'success' | 'error') {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.className = `form-status form-status--${type}`;
    statusEl.hidden = false;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusEl) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    statusEl.hidden = true;

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();

      if (res.ok) {
        showStatus("Message sent. We'll get back to you shortly.", 'success');
        form.reset();
      } else {
        throw new Error(data.error ?? 'Unknown error');
      }
    } catch (err: any) {
      showStatus(`Failed to send: ${err.message}. Try emailing directly.`, 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    }
  });
</script>
