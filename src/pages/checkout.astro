---
import StandardPageLayout from '../layouts/StandardPageLayout.astro';
---
<StandardPageLayout title="Checkout — Starstuck Lab" description="Complete your order" backgroundScene="shop">
  <main class="checkout-page">
    <header class="checkout-page__header">
      <h1>Checkout</h1>
      <p class="checkout-page__subtitle">Review your order and proceed to payment.</p>
    </header>

    <div id="checkout-content">
      <div id="cart-summary" class="cart-summary">
        <!-- Populated by JS from localStorage -->
        <p class="cart-summary__empty" id="empty-message" hidden>Your cart is empty.</p>
      </div>

      <div class="checkout-actions" id="checkout-actions" hidden>
        <div class="checkout-total">
          <span>Total</span>
          <span id="checkout-total-amount">—</span>
        </div>
        <p class="checkout-note">
          You'll be redirected to Stripe's secure payment page.
          We accept all major cards and UPI.
        </p>
        <button id="pay-button" class="btn btn--primary btn--large">
          Proceed to Payment
        </button>
        <p class="checkout-error" id="checkout-error" hidden></p>
      </div>
    </div>
  </main>
</StandardPageLayout>

<script>
  interface CartItem {
    productSlug: string;
    title: string;
    price: number;
    quantity: number;
    customization?: Record<string, string>;
  }

  function loadCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('cart') ?? '[]');
    } catch {
      return [];
    }
  }

  function formatINR(amount: number): string {
    return '₹' + amount.toLocaleString('en-IN');
  }

  function renderCart(items: CartItem[]) {
    const container = document.getElementById('cart-summary')!;
    const actions = document.getElementById('checkout-actions')!;
    const emptyMsg = document.getElementById('empty-message')!;
    const totalEl = document.getElementById('checkout-total-amount')!;

    if (!items.length) {
      emptyMsg.hidden = false;
      return;
    }

    const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
    totalEl.textContent = formatINR(total);

    const list = document.createElement('ul');
    list.className = 'cart-summary__list';

    items.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'cart-summary__item';

      const customText = item.customization
        ? Object.entries(item.customization).map(([k, v]) => `${k}: ${v}`).join(', ')
        : '';

      li.innerHTML = `
        <div class="cart-item__info">
          <strong class="cart-item__title">${item.title}</strong>
          ${customText ? `<span class="cart-item__custom">${customText}</span>` : ''}
        </div>
        <div class="cart-item__qty">× ${item.quantity}</div>
        <div class="cart-item__price">${formatINR(item.price * item.quantity)}</div>
      `;
      list.appendChild(li);
    });

    container.appendChild(list);
    actions.hidden = false;
  }

  async function startCheckout(items: CartItem[]) {
    const button = document.getElementById('pay-button') as HTMLButtonElement;
    const errorEl = document.getElementById('checkout-error') as HTMLElement;

    button.disabled = true;
    button.textContent = 'Preparing payment…';
    errorEl.hidden = true;

    try {
      const res = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items }),
      });

      const data = await res.json();

      if (!res.ok || !data.url) {
        throw new Error(data.error ?? 'Unknown error');
      }

      window.location.href = data.url;
    } catch (err: any) {
      errorEl.textContent = `Payment failed to start: ${err.message}. Please try again.`;
      errorEl.hidden = false;
      button.disabled = false;
      button.textContent = 'Proceed to Payment';
    }
  }

  const cart = loadCart();
  renderCart(cart);

  document.getElementById('pay-button')?.addEventListener('click', () => {
    startCheckout(cart);
  });
</script>

<style>
  .checkout-page {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-4);
  }

  .checkout-page__header {
    margin-bottom: var(--space-8);
  }

  .checkout-page__header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .checkout-page__subtitle {
    color: var(--color-muted);
  }

  .cart-summary__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .cart-summary__item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item__title {
    display: block;
    font-weight: 600;
  }

  .cart-item__custom {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: var(--space-1);
  }

  .cart-item__qty {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .cart-item__price {
    font-weight: 600;
    white-space: nowrap;
  }

  .checkout-total {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xl);
    font-weight: 700;
    padding: var(--space-4) 0;
    border-top: 2px solid var(--color-text);
    margin-bottom: var(--space-4);
  }

  .checkout-note {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .checkout-error {
    margin-top: var(--space-4);
    color: #c0392b;
    font-size: var(--text-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 2px solid currentColor;
    border-radius: 4px;
    font-weight: 600;
    font-size: var(--text-base);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .btn--primary:hover:not(:disabled) {
    background: transparent;
    color: var(--color-text);
  }

  .btn--primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn--large {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    width: 100%;
  }
</style>
