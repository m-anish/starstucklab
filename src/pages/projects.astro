---
// site/src/pages/projects.astro
// Updated to use Astro Content Collections for markdown projects
import { getCollection } from 'astro:content';
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/components/parchment.css";
import "../styles/components/projects.css";

// Get all projects from content collection
const allProjects = await getCollection('projects');

// Sort by date descending (newest first)
const sortedProjects = allProjects
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

// Transform to ProjectCard format
const projectsForCards = sortedProjects.map(entry => ({
  id: entry.id,
  slug: entry.slug,
  title: entry.data.title,
  excerpt: entry.data.excerpt,
  category: entry.data.category,
  status: entry.data.status,
  tags: entry.data.tags || [],
  date: entry.data.date,
  image: entry.data.image || `/assets/projects/${entry.slug}/hero.webp`,
  image_fallback: `/assets/projects/${entry.slug}/master.png`,
  url: `/projects/${entry.slug}`
}));

// Group by category for optional filtering UI
const byCategory = projectsForCards.reduce((acc, proj) => {
  const cat = proj.category || 'Uncategorized';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(proj);
  return acc;
}, {} as Record<string, typeof projectsForCards>);

const categories = Object.keys(byCategory).sort();
---

<StandardPageLayout 
  title="Projects — Starstuck Lab" 
  pageClass="projects-page" 
  backgroundScene="shop"
>
  <div class="projects-content">
    <header class="projects-hero">
      <h1>The Workbench</h1>
      <p class="lead">
        Things built between coffee runs and cosmic indifference. Some work, some don't. 
        Most are still thinking about it.
      </p>
    </header>

    {projectsForCards.length === 0 ? (
      <div class="parchment parchment--centered no-projects">
        <p>No projects documented yet. The workbench is still being organized.</p>
        <p style="margin-top: 1rem; font-size: 0.9rem; opacity: 0.8;">
          Add one with: <code>python3 tools/projects_cli.py add "Project Title"</code>
        </p>
      </div>
    ) : (
      <>
        <!-- Optional: Category filter UI -->
        {categories.length > 1 && (
          <div class="category-filter">
            <span class="filter-label">Filter:</span>
            {categories.map(cat => (
              <button class="filter-btn" data-category={cat}>
                {cat}
              </button>
            ))}
            <button class="filter-btn active" data-category="all">
              All
            </button>
          </div>
        )}

        <section class="projects-grid" role="list">
          {projectsForCards.map(project => (
            <ProjectCard project={project} />
          ))}
        </section>
      </>
    )}
  </div>
</StandardPageLayout>

<style>
  /* Category filter */
  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-bottom: var(--space-10);
    padding: var(--space-5);
  }
  
  .filter-label {
    font-weight: 600;
    color: var(--starry-white);
    margin-right: var(--space-2);
    align-self: center;
  }
  
  .filter-btn {
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition-fast),
                border-color var(--transition-fast);
  }
  
  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }
  
  .filter-btn.active {
    background: rgba(78, 197, 122, 0.15);
    border-color: rgba(78, 197, 122, 0.4);
    color: rgba(78, 197, 122, 0.95);
  }
  
  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.85em;
  }
</style>

<script>
  // Client-side category filtering
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        
        // Update active state
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter cards
        cards.forEach(card => {
          const cardCategory = card.querySelector('.project-category')?.textContent.trim();
          
          if (category === 'all' || cardCategory === category) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
