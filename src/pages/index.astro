---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartBadge from '../components/CartBadge.astro';

const allProducts = await getCollection('products');
const featuredProducts = allProducts
  .filter((p) => p.data.status === 'available')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const labNotes = await getCollection('lab-notes')
  .catch(() => []);
const latestNotes = labNotes
  .sort((a, b) => (b.data as any).date?.getTime() - (a.data as any).date?.getTime())
  .slice(0, 2);

function formatPrice(price: number): string {
  return '₹' + price.toLocaleString('en-IN');
}
---
<BaseLayout
  title="Starstuck Lab — Handmade telescopes for an indifferent universe"
  description="Handmade 3D-printed telescopes built to order in India. Sardonic by default, optically sound by design."
>
  <Navbar />

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="hero__content container">
      <p class="hero__eyebrow">Handmade in India</p>
      <h1 class="hero__title">
        Building small machines<br>for an indifferent universe.
      </h1>
      <p class="hero__subtitle">
        3D-printed telescopes. Hand-assembled. Built to order.
        Philosophically grounded in the fact that the cosmos doesn't care,
        but the optics are very good.
      </p>
      <div class="hero__actions">
        <a href="/shop" class="btn btn--primary">Browse the Shop</a>
        <a href="/lab" class="btn btn--ghost">Read the Lab Notes</a>
      </div>
    </div>
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__star hero__star--1">✦</div>
      <div class="hero__star hero__star--2">✦</div>
      <div class="hero__star hero__star--3">✦</div>
    </div>
  </section>

  <!-- ── Products ── -->
  <section class="featured-products">
    <div class="container">
      <header class="section-header">
        <h2 class="section-header__title">Telescopes</h2>
        <a href="/shop" class="section-header__link">All products →</a>
      </header>

      <div class="products-grid">
        {featuredProducts.map((product) => {
          const { title, tagline, price, stock_status, lead_time, images } = product.data;
          const isBuildToOrder = stock_status === 'build_to_order';
          return (
            <a href={`/shop/${product.slug}`} class="fp-card">
              <div class="fp-card__image-wrap">
                {images?.master ? (
                  <img src={images.master} alt={title} class="fp-card__image" loading="lazy" />
                ) : (
                  <div class="fp-card__placeholder" aria-hidden="true">✦</div>
                )}
              </div>
              <div class="fp-card__body">
                <div class="fp-card__meta">
                  {isBuildToOrder && <span class="fp-card__badge">Build to Order</span>}
                </div>
                <h3 class="fp-card__title">{title}</h3>
                {tagline && <p class="fp-card__tagline">{tagline}</p>}
                <div class="fp-card__footer">
                  <span class="fp-card__price">{price ? formatPrice(price) : '—'}</span>
                  {isBuildToOrder && lead_time && (
                    <span class="fp-card__lead">Ships in {lead_time}</span>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Brand statement ── -->
  <section class="brand-statement">
    <div class="container">
      <blockquote class="brand-statement__quote">
        "Every telescope we ship is a small argument against the idea that the universe
        is too large to be worth looking at carefully."
      </blockquote>
      <p class="brand-statement__byline">— Starstuck Lab, probably at 2am</p>
    </div>
  </section>

  <!-- ── Lab Notes preview ── -->
  {latestNotes.length > 0 && (
    <section class="lab-preview">
      <div class="container">
        <header class="section-header">
          <h2 class="section-header__title">Lab Notes</h2>
          <a href="/lab" class="section-header__link">All notes →</a>
        </header>
        <div class="lab-preview__list">
          {latestNotes.map((note) => {
            const data = note.data as any;
            return (
              <a href={`/lab/${note.slug}`} class="lab-preview__card">
                <span class="lab-preview__date">
                  {new Date(data.date).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}
                </span>
                <span class="lab-preview__title">{data.title}</span>
                <span class="lab-preview__arrow">→</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 90dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--navbar-height);
  }

  .hero__content {
    position: relative;
    z-index: var(--z-above);
    max-width: 720px;
    padding-top: var(--space-20);
    padding-bottom: var(--space-24);
  }

  .hero__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-base);
    max-width: 52ch;
    margin-bottom: var(--space-10);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__star {
    position: absolute;
    color: var(--color-accent);
    opacity: 0.15;
    animation: twinkle 4s ease-in-out infinite;
  }

  .hero__star--1 { top: 15%; right: 12%; font-size: 2rem; animation-delay: 0s; }
  .hero__star--2 { top: 55%; right: 25%; font-size: 1rem; animation-delay: 1.5s; }
  .hero__star--3 { top: 30%; right: 8%;  font-size: 0.75rem; animation-delay: 3s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.08; }
    50% { opacity: 0.25; }
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid currentColor;
    border-radius: var(--radius-md);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    transition: background var(--transition-base), color var(--transition-base);
  }

  .btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .btn--primary:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  .btn--ghost:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
  }

  /* ── Section header ── */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
  }

  .section-header__link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
  }

  .section-header__link:hover {
    color: var(--color-accent);
  }

  /* ── Featured products ── */
  .featured-products {
    padding: var(--space-20) 0;
    border-top: 1px solid var(--color-border);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .fp-card {
    display: block;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .fp-card:hover {
    border-color: var(--color-faint);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .fp-card__image-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .fp-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .fp-card:hover .fp-card__image {
    transform: scale(1.04);
  }

  .fp-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: var(--color-faint);
  }

  .fp-card__body {
    padding: var(--space-5) var(--space-5) var(--space-4);
  }

  .fp-card__meta {
    min-height: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .fp-card__badge {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(201, 185, 122, 0.1);
    border: 1px solid var(--color-accent-dim);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .fp-card__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .fp-card__tagline {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
    line-height: var(--leading-base);
    margin-bottom: var(--space-4);
  }

  .fp-card__footer {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .fp-card__price {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .fp-card__lead {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* ── Brand statement ── */
  .brand-statement {
    padding: var(--space-20) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  .brand-statement__quote {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-style: italic;
    color: var(--color-muted);
    max-width: 64ch;
    margin: 0 auto var(--space-4);
    line-height: var(--leading-loose);
  }

  .brand-statement__byline {
    font-size: var(--text-sm);
    color: var(--color-faint);
    font-family: var(--font-mono);
  }

  /* ── Lab preview ── */
  .lab-preview {
    padding: var(--space-20) 0;
  }

  .lab-preview__list {
    display: flex;
    flex-direction: column;
  }

  .lab-preview__card {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .lab-preview__card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .lab-preview__date {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  .lab-preview__title {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .lab-preview__card:hover .lab-preview__title {
    color: var(--color-accent);
  }

  .lab-preview__arrow {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 480px) {
    .products-grid { grid-template-columns: 1fr; }
    .hero__actions { flex-direction: column; }
    .hero__actions .btn { text-align: center; justify-content: center; }
  }
</style>
