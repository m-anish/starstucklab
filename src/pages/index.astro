---
// V2 index.astro — V1 visual restoration with V2 e-commerce architecture
import HeroLayout from "../layouts/HeroLayout.astro";
import AboutPanel from "../components/aboutpanel.astro";
import FeaturedSections from "../components/FeaturedSections.astro";
import Footer from "../components/Footer.astro";
import { getSceneSources } from "../lib/scenes";

const base = (Astro.site?.pathname || '/').replace(/\/?$/, '/');
const hero = getSceneSources("hero", base);
const workshop = getSceneSources("workshop", base);
const preloadUrls = [
  hero.desktop,
  hero.generated,
  workshop.desktop,
  workshop.generated,
].filter(Boolean);

const MEDIA = {
  desktop: "(min-width:1000px)",
  laptop: "(min-width:820px)",
  tablet: "(min-width:640px)",
};
---

<HeroLayout
  title="Starstuck Lab — Handmade telescopes for an indifferent universe"
  description="Handmade 3D-printed telescopes built to order in India. Sardonic by default, optically sound by design."
>
  <Fragment slot="head">
    {preloadUrls.map((u) => u && <link rel="preload" as="image" href={u} />)}
    <meta name="base-url" content={base} />
  </Fragment>

  <script>
    // Force scroll to top on page load/reload
    if ("scrollRestoration" in window.history) {
      window.history.scrollRestoration = "manual";
    }
    window.scrollTo(0, 0);
  </script>

  <script>
    // Prevent initial transition flicker
    (function () {
      try {
        document.documentElement.classList.add("no-transitions");
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove("no-transitions");
          });
        });
      } catch (e) {
        /* ignore */
      }
    })();
  </script>

  <div class="herozoom-root" id="herozoomRoot">
    <div
      class="herozoom-spacer"
      id="herozoomSpacer"
      data-cross-start="0.15"
      data-cross-end="0.85"
    ></div>

    <!-- Workshop interior (back layer, fades IN on scroll) -->
    <picture>
      {workshop.desktop ? (
        <source media={MEDIA.desktop} srcset={workshop.desktop} />
      ) : (
        <source media={MEDIA.desktop} srcset={`${base}assets/workshop/workshop-desktop.webp`} />
      )}
      {workshop.tablet ? (
        <source media={MEDIA.tablet} srcset={workshop.tablet} />
      ) : (
        <source media={MEDIA.tablet} srcset={`${base}assets/workshop/workshop-tablet.webp`} />
      )}
      <img
        class="hero-layer layer-interior"
        id="hzInterior"
        src={workshop.mobile ?? workshop.generated ?? workshop.thumb ?? workshop.desktop ?? `${base}assets/workshop/workshop-mobile.webp`}
        alt="Workshop interior"
        loading="eager"
      />
    </picture>

    <!-- Hero forest scene (front layer, fades OUT on scroll) -->
    <picture>
      {hero.desktop ? (
        <source media={MEDIA.desktop} srcset={hero.desktop} />
      ) : null}
      {hero.laptop ? (
        <source media={MEDIA.laptop} srcset={hero.laptop} />
      ) : null}
      {hero.tablet ? (
        <source media={MEDIA.tablet} srcset={hero.tablet} />
      ) : null}
      <img
        class="hero-layer layer-forest"
        id="hzForest"
        src={hero.mobile ?? hero.generated ?? hero.thumb ?? hero.desktop ?? `${base}assets/hero/hero-master.webp`}
        alt="Forest hero with cabin and STARSTUCKLAB sign"
        loading="eager"
      />
    </picture>

    <!-- Hero overlay: logo + title + subtitle + CTA -->
    <div class="hero-overlay" id="hzOverlay" role="region" aria-label="Hero">
      <img
        id="hzHeroLogo"
        src={`${base}assets/icons/starstucklab_logo_black_white.svg`}
        alt="Starstuck Lab Logo"
        loading="eager"
      />
      <h1 class="hero-title">Starstuck Lab</h1>
      <p class="hero-lead">Building small machines for an indifferent universe</p>
      <a href="#workbench" class="cta">
        <span class="cta-label">Enter the Workshop <span class="cta-arrow">↓</span></span>
      </a>
    </div>

    <!-- Painted vignette: soft center, edges fall off. Above bg layers, below overlay. -->
    <div class="painted-vignette" aria-hidden="true"></div>

    <!-- Shooting stars layer. Visible only on the hero (pre-crossfade), and
         hidden under prefers-reduced-motion. Two SVG groups so a follow-up
         streak can render mid-flight without resetting the primary's transform. -->
    <svg
      id="shootingStars"
      viewBox="0 0 1000 1000"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="starTail" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#fff7e6" stop-opacity="0" />
          <stop offset="55%" stop-color="#fff7e6" stop-opacity=".55" />
          <stop offset="92%" stop-color="#fffaf0" stop-opacity=".95" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="1" />
        </linearGradient>
        <radialGradient id="starHead" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="40%" stop-color="#fff5d8" stop-opacity=".75" />
          <stop offset="100%" stop-color="#fff5d8" stop-opacity="0" />
        </radialGradient>
        <filter id="starGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.4" />
        </filter>
      </defs>
      <g id="starGroup" style="opacity:0">
        <g id="starInner">
          <rect x="0" y="-0.6" width="180" height="1.2" rx=".6" fill="url(#starTail)" filter="url(#starGlow)" />
          <circle cx="180" cy="0" r="3.2" fill="url(#starHead)" />
          <circle cx="180" cy="0" r="1.1" fill="#ffffff" />
        </g>
      </g>
      <g id="starGroup2" style="opacity:0">
        <g id="starInner2">
          <rect x="0" y="-0.5" width="150" height="1" rx=".5" fill="url(#starTail)" filter="url(#starGlow)" />
          <circle cx="150" cy="0" r="2.6" fill="url(#starHead)" />
          <circle cx="150" cy="0" r=".9" fill="#ffffff" />
        </g>
      </g>
    </svg>

    <!-- Post-scroll content: 2/3 shop cards + 1/3 about panel -->
    <div class="post-zoom" id="postZoomContent" aria-live="polite">
      <div class="homepage-layout">
        <div class="homepage-main">
          <FeaturedSections />
        </div>
        <aside class="homepage-aside">
          <AboutPanel />
        </aside>
      </div>
      <Footer />
    </div>
  </div>

  <!-- HERO ZOOM + SCROLL TRANSITION SCRIPT -->
  <script>
    (function () {
      const spacerEl = document.getElementById("herozoomSpacer");
      const forestEl = document.getElementById("hzForest");
      const interiorEl = document.getElementById("hzInterior");
      const overlayEl = document.getElementById("hzOverlay");
      const navEl = document.getElementById("pageNav");
      const aboutEl = document.getElementById("aboutPanel");
      const postZoomEl = document.getElementById("postZoomContent");

      if (!spacerEl || !forestEl || !interiorEl || !overlayEl || !navEl) return;

      const ds = spacerEl.dataset;
      const CROSS_START = parseFloat(ds.crossStart ?? "0.15");
      const CROSS_END = parseFloat(ds.crossEnd ?? "0.85");
      const NAV_SHOW_THRESHOLD = 0.45;
      const ABOUT_SHOW_THRESHOLD = 0.78;
      const POST_ZOOM_THRESHOLD = 0.85;
      let ticking = false;
      let cachedSpacerTop = 0;
      let cachedSpacerHeight = 0;
      let measurementsValid = false;

      function updateMeasurements() {
        const rect = spacerEl.getBoundingClientRect();
        cachedSpacerTop = window.scrollY + rect.top;
        cachedSpacerHeight = rect.height;
        measurementsValid = true;
      }

      function spacerTopAbsolute() {
        if (!measurementsValid) updateMeasurements();
        return cachedSpacerTop;
      }

      function spacerHeight() {
        if (!measurementsValid) updateMeasurements();
        return cachedSpacerHeight;
      }

      function computeProgress() {
        const top = spacerTopAbsolute();
        const duration = spacerHeight() - window.innerHeight;
        if (window.scrollY <= top) return 0;
        if (duration <= 0) return 1;
        const p = (window.scrollY - top) / duration;
        return Math.max(0, Math.min(1, p));
      }

      function applyInitialFrame() {
        forestEl.style.opacity = "1";
        forestEl.style.transform = "scale(1)";
        interiorEl.style.opacity = "0";
        interiorEl.style.transform = "scale(1.20)";
        overlayEl.style.opacity = "1";
        document.body.classList.add("hero-mode");
        if (aboutEl) aboutEl.classList.remove("in");
        if (postZoomEl) {
          postZoomEl.classList.remove("in");
          postZoomEl.setAttribute("aria-hidden", "true");
        }
      }

      function update() {
        const p = computeProgress();

        let interiorOpacity = 0;
        if (p <= CROSS_START) {
          interiorOpacity = 0;
        } else if (p >= CROSS_END) {
          interiorOpacity = 1;
        } else {
          interiorOpacity = (p - CROSS_START) / (CROSS_END - CROSS_START);
        }

        const forestOpacity = Math.max(0, 1 - interiorOpacity * 1.05);
        const overlayOpacity = Math.max(0, 1 - p * 1.2);

        // Smoothstep so the zoom feels less mechanical.
        const eased = interiorOpacity * interiorOpacity * (3 - 2 * interiorOpacity);
        // Forest scales 1.0 -> 1.25 as we fly past it.
        const forestScale = 1 + eased * 0.25;
        // Workshop scales 1.20 -> 1.0 as we pull into it.
        const interiorScale = 1.20 - eased * 0.20;

        forestEl.style.opacity = `${forestOpacity}`;
        forestEl.style.transform = `scale(${forestScale.toFixed(4)})`;
        interiorEl.style.opacity = `${interiorOpacity}`;
        interiorEl.style.transform = `scale(${interiorScale.toFixed(4)})`;
        overlayEl.style.opacity = `${overlayOpacity}`;

        if (overlayOpacity <= 0.1) {
          overlayEl.classList.add("faded");
        } else {
          overlayEl.classList.remove("faded");
        }

        // Reveal the nav (and drop body.hero-mode) once we're clearly past
        // the hero, near the crossfade midpoint.
        const navVisible = interiorOpacity > NAV_SHOW_THRESHOLD;
        document.body.classList.toggle("hero-mode", !navVisible);
        if (navVisible) {
          navEl.classList.add("nav-visible", "nav-sticky");
          navEl.classList.remove("nav-hidden");
          navEl.setAttribute("aria-hidden", "false");
        } else {
          navEl.classList.remove("nav-visible", "nav-sticky");
          navEl.classList.add("nav-hidden");
          navEl.setAttribute("aria-hidden", "true");
        }

        if (aboutEl) {
          const shouldBeIn = interiorOpacity > ABOUT_SHOW_THRESHOLD;
          if (shouldBeIn && !aboutEl.classList.contains("in")) {
            aboutEl.classList.add("in");
          } else if (!shouldBeIn && aboutEl.classList.contains("in")) {
            aboutEl.classList.remove("in");
          }
        }

        if (postZoomEl) {
          const shouldBeIn = interiorOpacity > POST_ZOOM_THRESHOLD;
          if (shouldBeIn && !postZoomEl.classList.contains("in")) {
            postZoomEl.classList.add("in");
            postZoomEl.setAttribute("aria-hidden", "false");
          } else if (!shouldBeIn && postZoomEl.classList.contains("in")) {
            postZoomEl.classList.remove("in");
            postZoomEl.setAttribute("aria-hidden", "true");
          }
        }

        ticking = false;
      }

      function requestTick() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      function onScroll() {
        requestTick();
      }

      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          applyInitialFrame();
          update();
        })
      );

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          measurementsValid = false;
          requestTick();
        },
        { passive: true }
      );

      // CTA scroll-to-workbench
      const cta = document.querySelector(".cta");
      const aboutPanel = document.getElementById("aboutPanel");
      if (cta && aboutPanel) {
        cta.addEventListener("click", (ev) => {
          ev.preventDefault();
          const rect = aboutPanel.getBoundingClientRect();
          const targetY =
            window.scrollY + rect.top - Math.round(window.innerHeight * 0.4);
          window.scrollTo({ top: Math.max(0, targetY), behavior: "smooth" });
          history.replaceState(null, "", "#workbench");
        });
      }

      // Fallback for non-scrollable pages (very tall screens / short content)
      function pageIsScrollable() {
        return document.documentElement.scrollHeight > window.innerHeight + 10;
      }

      if (!pageIsScrollable()) {
        const reveal = () => {
          forestEl.style.opacity = "0";
          forestEl.style.transform = "scale(1.25)";
          interiorEl.style.opacity = "1";
          interiorEl.style.transform = "scale(1)";
          overlayEl.style.opacity = "0";
          document.body.classList.remove("hero-mode");
          navEl.classList.add("nav-visible", "nav-sticky");
          navEl.classList.remove("nav-hidden");
          navEl.setAttribute("aria-hidden", "false");
          if (aboutEl) aboutEl.classList.add("in");
          if (postZoomEl) {
            postZoomEl.classList.add("in");
            postZoomEl.setAttribute("aria-hidden", "false");
          }
        };

        const onFirstInput = () => {
          reveal();
          window.removeEventListener("wheel", onFirstInput);
          window.removeEventListener("touchstart", onFirstInput);
          window.removeEventListener("keydown", onFirstInput);
        };

        window.addEventListener("wheel", onFirstInput, { passive: true });
        window.addEventListener("touchstart", onFirstInput, { passive: true });
        window.addEventListener("keydown", onFirstInput, { passive: true });
        setTimeout(() => {
          if (!pageIsScrollable()) reveal();
        }, 1200);
      }
    })();
  </script>

  <!-- SHOOTING STARS (Studio-Ghibli flavor)
       Painted streaks across the hero sky. Visible only while the user is
       still near the top (pre-crossfade). One star every 22-38s, with a
       1-in-6 chance of a follow-up doubled streak 0.4-1.2s later. The
       layer is hidden entirely under prefers-reduced-motion. -->
  <script>
    (function shootingStars() {
      const stars = document.getElementById("shootingStars");
      const group = document.getElementById("starGroup");
      const group2 = document.getElementById("starGroup2");
      if (!stars || !group || !group2) return;

      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)");
      if (reduce && reduce.matches) {
        stars.style.display = "none";
        return;
      }

      let timer = null;

      function setVisible() {
        const vh = window.innerHeight || 800;
        const progress = window.scrollY / vh;
        // Hide as soon as the workshop crossfade starts (matches CROSS_START 0.15).
        stars.style.opacity = progress < 0.18 ? "1" : "0";
      }
      window.addEventListener("scroll", setVisible, { passive: true });
      window.addEventListener("resize", setVisible);

      // Aspect-aware vertical ceiling so star arcs never dip into the
      // painted cabin / STARSTUCKLAB sign band.
      function arcCeiling() {
        const ar = (window.innerWidth || 800) / (window.innerHeight || 800);
        if (ar < 0.65) return 260;
        if (ar < 1.00) return 320;
        if (ar < 1.40) return 380;
        return 440;
      }

      function fire(double) {
        if (stars.style.opacity === "0") {
          if (!double) schedule();
          return;
        }
        const target = double ? group2 : group;
        const ceil = arcCeiling();
        const baseX = 40 + Math.random() * 360;
        const baseY = 30 + Math.random() * (ceil - 30);
        const x = double ? baseX + 30 + Math.random() * 40 : baseX;
        const y = double ? baseY + 18 + Math.random() * 24 : baseY;
        const angle = 12 + Math.random() * 14;
        const maxDownward = (ceil + 80) - y;
        const distByY = maxDownward / Math.sin((angle * Math.PI) / 180);
        const dist = Math.min(320 + Math.random() * 240, distByY);
        const dur = 1200 + Math.random() * 700;
        const dx = Math.cos((angle * Math.PI) / 180) * dist;
        const dy = Math.sin((angle * Math.PI) / 180) * dist;
        target.classList.remove("firing");
        target.setAttribute("transform", `translate(${x},${y}) rotate(${angle})`);
        target.style.setProperty("--dx", dx + "px");
        target.style.setProperty("--dy", dy + "px");
        target.style.setProperty("--dur", dur + "ms");
        // Force reflow so the animation restarts cleanly.
        void target.getBoundingClientRect();
        target.classList.add("firing");

        if (!double) {
          if (Math.random() < 1 / 6) {
            setTimeout(() => fire(true), 400 + Math.random() * 800);
          }
          schedule();
        }
      }

      function schedule() {
        clearTimeout(timer);
        const wait = 22000 + Math.random() * 16000; // 22-38s
        timer = setTimeout(() => fire(false), wait);
      }

      setVisible();
      // First star arrives 4-9s after page load.
      setTimeout(() => fire(false), 4000 + Math.random() * 5000);
    })();
  </script>

  <!-- AI Hero content: randomly pick variant from /data/hero.json -->
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      try {
        const baseMeta = document.querySelector('meta[name="base-url"]');
        const base = baseMeta ? baseMeta.getAttribute("content") || "/" : "/";
        const res = await fetch(`${base}data/hero.json`);
        if (!res.ok) return;
        const variants = await res.json();
        const keys = Object.keys(variants);
        if (!keys.length) return;
        const randomKey = keys[Math.floor(Math.random() * keys.length)];
        const hero = variants[randomKey];
        const titleEl = document.querySelector(".hero-title");
        const leadEl = document.querySelector(".hero-lead");
        const ctaLabel = document.querySelector(".cta .cta-label");
        const ctaArrow = document.querySelector(".cta .cta-arrow");
        if (titleEl && hero.title) titleEl.textContent = hero.title;
        if (leadEl && hero.subtitle) leadEl.textContent = hero.subtitle;
        // Preserve the trailing arrow element when swapping CTA copy.
        if (ctaLabel && hero.cta) {
          ctaLabel.textContent = hero.cta + " ";
          if (ctaArrow) ctaLabel.appendChild(ctaArrow);
        }
      } catch (err) {
        console.error("Hero variant loading failed:", err);
      }
    });
  </script>
</HeroLayout>

<style>
  /* ══════════════════════════════════════════
     HOMEPAGE: 2/3 content + 1/3 about panel
  ══════════════════════════════════════════ */
  .homepage-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
    max-width: 1500px;
    margin: 0 auto;
    padding: 1rem 1.5rem 0;
  }

  .homepage-main {
    min-width: 0; /* prevent grid blowout */
  }

  .homepage-aside {
    position: sticky;
    top: 80px; /* below fixed nav when visible */
  }

  /* Tablet: slightly tighter ratio */
  @media (max-width: 1200px) {
    .homepage-layout {
      grid-template-columns: 3fr 2fr;
    }
  }

  /* Mobile: stack vertically, about panel above products */
  @media (max-width: 820px) {
    .homepage-layout {
      grid-template-columns: 1fr;
      padding: 1rem 1rem 0;
      gap: 1.5rem;
    }

    .homepage-aside {
      position: static;
      order: -1;
    }
  }
</style>
