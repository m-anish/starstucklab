---
// src/pages/shop/[slug].astro
import { getCollection } from 'astro:content';

export const prerender = true;
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import ProductNav from "../../components/ProductNav.astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import CustomizationPanel from "../../components/CustomizationPanel.astro";
import "../../styles/components/parchment.css";
import "../../styles/components/product-detail.css";
import "../../styles/components/customization.css";

export async function getStaticPaths() {
  const products = await getCollection('products');
  if (products.length === 0) {
    console.warn('getStaticPaths: no product markdown files found');
  }
  return products.map(entry => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/shop');
}

let Content;
try {
  const renderResult = await entry.render();
  Content = renderResult.Content;
} catch (error) {
  console.error('Error rendering product content:', error);
  Content = () => null;
}

const product = entry.data;
const slug = entry.slug;

// Check if this is the M42 product
const isM42 = slug === 'm42';

// Image paths
const heroImagePath = product.images?.master?.replace('public/', '/') || `/assets/product-${slug}/product-${slug}-hero.webp`;
const masterFallback = `/assets/product-${slug}/product-${slug}-master.png`;

// Icon mapping
const iconMap: Record<string, string> = {
  'telescope': '🔭',
  'palette': '🎨',
  'alert-triangle': '⚠️',
  'cog': '⚙️',
  'zap': '⚡',
  'box': '📦',
  'cpu': '🖥️',
  'settings': '⚙️',
  'shield': '🛡️',
  'star': '⭐',
  'circle-dot': '🎯',
  'gauge': '📊'
};

// Stock status display
const stockStatusMap: Record<string, { label: string; class: string }> = {
  'in_stock': { label: 'In stock', class: 'in-stock' },
  'low_stock': { label: 'Low stock', class: 'low-stock' },
  'out_of_stock': { label: 'Out of stock', class: 'out-of-stock' },
  'pre_order': { label: 'Pre-order', class: 'pre-order' }
};

const stockStatus = product.stock_status ? stockStatusMap[product.stock_status] : stockStatusMap['in_stock'];
---

<StandardPageLayout title={`${product.title} — Starstuck Lab`} backgroundScene="shop">
  <ProductNav product={{ slug, title: product.title }} />

  <div class="product-detail-v2">
    <!-- Enhanced Hero for M42 -->
    {isM42 ? (
      <section class="product-hero product-hero--customizable">
        <div class="product-hero-left">
          <div class="customization-badge">
            <span class="badge-icon">✨</span>
            <span class="badge-text">Fully Customizable</span>
          </div>
          
          <h1 class="product-title">{product.title}</h1>
          {product.tagline && (
            <p class="product-tagline">{product.tagline}</p>
          )}
          
          {product.price && (
            <div class="product-price-block">
              <span class="product-price">{product.currency || 'USD'} {product.price}</span>
              <small class="price-note">Base configuration • Customize to adjust price</small>
            </div>
          )}
          
          <!-- Primary CTA: Go to Customizer Page -->
          <a href="/shop/m42-customizer" class="cta-primary cta-customize">
            <span class="cta-icon">🎨</span>
            <span class="cta-text">
              <strong>Customize Your M42</strong>
              <small>Choose colors, preview in 3D</small>
            </span>
            <span class="cta-arrow">→</span>
          </a>
          
          <!-- Secondary CTA: Quick Add (Standard Config) -->
          {product.status === 'available' && (
            <div class="cta-secondary-wrap">
              <AddToCartButton product={{
                slug: slug,
                title: product.title,
                price: product.price,
                currency: product.currency,
                status: product.status
              }} />
              <small class="quick-add-note">Add standard configuration without customization</small>
            </div>
          )}
          
          <div class={`product-stock ${stockStatus.class}`}>
            {stockStatus.label}
          </div>
        </div>
        
        <div class="product-hero-right">
          <img
            src={heroImagePath}
            alt={product.title}
            class="product-hero-image"
            onerror={`this.onerror=null;this.src='${masterFallback}'`}
          />
        </div>
      </section>
    ) : (
      <!-- Standard Hero for Other Products -->
      <section class="product-hero">
        <div class="product-hero-left">
          <h1 class="product-title">{product.title}</h1>
          {product.tagline && (
            <p class="product-tagline">{product.tagline}</p>
          )}
          
          {product.price && (
            <div class="product-price-block">
              <span class="product-price">{product.currency || 'USD'} {product.price}</span>
            </div>
          )}
          
          {product.customization?.enabled && (
            <CustomizationPanel product={product} />
          )}
          
          {product.status === 'available' && (
            <div class="product-cta">
              <AddToCartButton product={{
                slug: slug,
                title: product.title,
                price: product.price,
                currency: product.currency,
                status: product.status
              }} />
            </div>
          )}
          
          <div class={`product-stock ${stockStatus.class}`}>
            {stockStatus.label}
          </div>
        </div>
        
        <div class="product-hero-right">
          <img
            src={heroImagePath}
            alt={product.title}
            class="product-hero-image"
            onerror={`this.onerror=null;this.src='${masterFallback}'`}
          />
        </div>
      </section>
    )}

    <!-- Features Section -->
    {product.features && product.features.length > 0 && (
      <section class="product-features" id="features">
        <h2>Features</h2>
        <div class="features-grid">
          {product.features.map((feature: any) => (
            <div class="feature-card">
              <div class="feature-icon">
                {iconMap[feature.icon] || '⚙️'}
              </div>
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-description">{feature.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Specifications -->
    {product.specifications && product.specifications.length > 0 && (
      <section class="product-specifications parchment" id="specifications">
        <h2>Specifications</h2>
        <table class="specs-table">
          {product.specifications.map((spec: any) => (
            <tr>
              <th>{spec.label}</th>
              <td>{spec.value}</td>
            </tr>
          ))}
        </table>
      </section>
    )}

    <!-- Full Description -->
    <section class="product-description parchment" id="reviews">
      <div class="markdown-content">
        <Content />
      </div>
    </section>

    <!-- Back Link -->
    <footer class="product-footer">
      <a href="/shop" class="back-link">
        ← Back to Shop
      </a>
    </footer>
  </div>

  <!-- M42 Specific Styles -->
  {isM42 && (
    <style>
      .customization-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: rgba(78, 197, 122, 0.15);
        border: 1px solid rgba(78, 197, 122, 0.3);
        border-radius: 24px;
        margin-bottom: 16px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--starry-white);
      }

      .badge-icon {
        font-size: 1.2rem;
      }

      .price-note {
        display: block;
        margin-top: 8px;
        font-size: 0.85rem;
        color: rgba(248, 244, 232, 0.7);
        font-style: italic;
      }

      .cta-primary {
        width: 100%;
        max-width: 400px;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 28px;
        background: linear-gradient(135deg, #2a7a4f 0%, #1d5a3d 100%);
        border: 2px solid #2a7a4f;
        border-radius: 12px;
        color: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin: 24px 0 16px 0;
        box-shadow: 0 4px 16px rgba(42, 122, 79, 0.3);
        text-decoration: none;
      }

      .cta-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(42, 122, 79, 0.4);
        color: white;
      }

      .cta-icon {
        font-size: 1.5rem;
      }

      .cta-text {
        flex: 1;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .cta-text strong {
        font-size: 1.1rem;
      }

      .cta-text small {
        font-size: 0.85rem;
        font-weight: 400;
        opacity: 0.9;
      }

      .cta-arrow {
        font-size: 1.5rem;
        transition: transform 0.2s ease;
      }

      .cta-primary:hover .cta-arrow {
        transform: translateX(4px);
      }

      .cta-secondary-wrap {
        margin: 12px 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .quick-add-note {
        font-size: 0.8rem;
        color: rgba(248, 244, 232, 0.6);
        font-style: italic;
      }

      @media (max-width: 900px) {
        .cta-primary {
          max-width: 100%;
          padding: 18px 24px;
        }
      }
    </style>
  )}
</StandardPageLayout>