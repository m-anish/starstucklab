---
import { getCollection, render } from 'astro:content';
import StandardPageLayout from '../../layouts/StandardPageLayout.astro';
import '../../styles/components/product-detail.css';

export const prerender = true;

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const {
  title,
  tagline,
  price,
  currency = 'INR',
  status,
  stock_status,
  lead_time,
  excerpt,
  features = [],
  customization,
  specifications = [],
  images,
  youtube_url,
} = product.data;

function getYouTubeEmbed(raw: string | undefined): string | null {
  if (!raw) return null;
  const match = raw.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/);
  const videoId = match ? match[1] : (raw.length === 11 ? raw : null);
  return videoId ? `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1` : null;
}

const embedUrl = getYouTubeEmbed(youtube_url);

const isAvailable = status === 'available';
const isBuildToOrder = stock_status === 'build_to_order';
const isOutOfStock = stock_status === 'out_of_stock';
const isPreOrder = stock_status === 'pre_order';
const isInStock = stock_status === 'in_stock';
const isLowStock = stock_status === 'low_stock';
const canAddToCart = isAvailable && !isOutOfStock;

function formatPrice(p: number, cur: string): string {
  if (cur === 'INR') return `₹${p.toLocaleString('en-IN')}`;
  return `${cur} ${p.toLocaleString()}`;
}

function stockClass() {
  if (isInStock) return 'in-stock';
  if (isLowStock) return 'low-stock';
  if (isOutOfStock) return 'out-of-stock';
  if (isBuildToOrder || isPreOrder) return 'pre-order';
  return '';
}

function stockLabel() {
  if (isInStock) return 'In stock — ships in 3 days';
  if (isLowStock) return `Low stock — ships in ${lead_time ?? 'a few days'}`;
  if (isOutOfStock) return 'Out of stock';
  if (isBuildToOrder) return `Build to order — ships in ${lead_time ?? '2–3 weeks'}`;
  if (isPreOrder) return 'Pre-order';
  return '';
}

const cartProduct = JSON.stringify({
  slug: product.slug,
  title,
  price: price ?? 0,
  currency,
});
---
<StandardPageLayout title={`${title} — Starstuck Lab`} description={excerpt} backgroundScene="workshop">
  <main class="product-detail-v2">

    <a href="/shop" class="back-link">← Back to shop</a>

    <!-- Hero: two-column layout matching design system -->
    <section class="product-hero">
      <div class="product-hero-left">
        <h1 class="product-title">{title}</h1>
        {tagline && <p class="product-tagline">{tagline}</p>}

        {price && (
          <div class="product-price-block">
            <div class="price-label">Price</div>
            <div class="price-details">
              <span class="product-price">{formatPrice(price, currency)}</span>
              <span class={`product-stock-above-price ${stockClass()}`}>
                <span class="dot" aria-hidden="true">●</span>
                {stockLabel()}
              </span>
            </div>
          </div>
        )}

        <!-- Customization (selects rendered per product schema) -->
        {customization?.enabled && customization.options && customization.options.length > 0 && (
          <div class="product-customization" id="customization-panel">
            {customization.options.map((option) => (
              <div class="customization__group">
                <label for={`opt-${option.label}`}>{option.label}</label>
                <select
                  id={`opt-${option.label}`}
                  data-option={option.label}
                  class="customization__select"
                >
                  {option.values.map((value) => (
                    <option value={value}>{value}</option>
                  ))}
                </select>
              </div>
            ))}
          </div>
        )}

        <!-- Add to cart -->
        <div class="product-cta">
          {canAddToCart ? (
            <button
              id="add-to-cart"
              class="add-to-cart-btn"
              data-product={cartProduct}
            >
              Add to cart
            </button>
          ) : (
            <button class="add-to-cart-btn" disabled aria-disabled="true">
              {isOutOfStock ? 'Out of stock' : 'Unavailable'}
            </button>
          )}
          <a href="/checkout" class="checkout-link" id="checkout-link" hidden>
            Proceed to checkout →
          </a>
        </div>
      </div>

      <div class="product-hero-right">
        {images?.master ? (
          <img
            src={images.master}
            alt={title}
            class="product-hero-image"
            loading="eager"
          />
        ) : (
          <div class="product-hero-image-placeholder" aria-hidden="true">✦</div>
        )}
      </div>
    </section>

    <!-- Features + Specs inside a single parchment slab (matches design) -->
    {(features.length > 0 || specifications.length > 0) && (
      <section class="specs-wrap">
        <article class="parchment specs-parchment" data-surface="parchment">
          <h2>What it does, more or less.</h2>
          {tagline && <p class="specs-lead">{tagline}</p>}

          {features.length > 0 && (
            <div class="feature-row">
              {features.map((f) => (
                <div class="feature-block">
                  <h3>{f.title}</h3>
                  <p>{f.description}</p>
                </div>
              ))}
            </div>
          )}

          {specifications.length > 0 && (
            <div class="specs-list">
              {specifications.map((spec) => (
                <div class="specs-row">
                  <span class="k">{spec.label}</span>
                  <span class="v">{spec.value}</span>
                </div>
              ))}
            </div>
          )}

          <svg class="specs-seal" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <path d="M50 4l11 32 33 1-27 19 10 32L50 70 23 88l10-32L6 37l33-1z" />
          </svg>
        </article>
      </section>
    )}

    <!-- YouTube demo -->
    {embedUrl && (
      <section class="product-video-section">
        <h2>See it in the wild</h2>
        <div class="video-frame">
          <iframe
            src={embedUrl}
            title={`${title} — video demo`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
    )}

    <!-- Markdown body inside its own parchment slab — long-form text reads
         far better on parchment than directly on the painted bg. -->
    <section class="product-body-wrap">
      <article class="parchment product-body-parchment" data-surface="parchment">
        <div class="product-body-content">
          <Content />
        </div>
      </article>
    </section>

  </main>
</StandardPageLayout>

<script>
  import { addToCart as addToCartStorage } from '../../lib/cart.ts';

  const selections: Record<string, string> = {};

  document.querySelectorAll<HTMLSelectElement>('.customization__select').forEach((sel) => {
    const optionName = sel.dataset.option || sel.id;
    selections[optionName] = sel.value;
    sel.addEventListener('change', () => {
      selections[optionName] = sel.value;
    });
  });

  const addBtn = document.getElementById('add-to-cart') as HTMLButtonElement | null;
  const checkoutLink = document.getElementById('checkout-link') as HTMLAnchorElement | null;

  addBtn?.addEventListener('click', () => {
    if (!addBtn.dataset.product) return;
    const p = JSON.parse(addBtn.dataset.product);
    addToCartStorage({
      slug: p.slug,
      title: p.title,
      price: String(p.price),
      currency: p.currency || 'INR',
    });

    const originalText = addBtn.textContent;
    addBtn.textContent = 'Added!';
    addBtn.disabled = true;
    if (checkoutLink) checkoutLink.hidden = false;

    // Auto-open the cart drawer 300ms after the click.
    setTimeout(() => {
      const openCart = (window as any).openCart;
      if (typeof openCart === 'function') openCart();
    }, 300);

    setTimeout(() => {
      addBtn.textContent = originalText || 'Add to cart';
      addBtn.disabled = false;
    }, 2000);
  });
</script>

<style>
  /* Page-level tweaks that complement product-detail.css */

  .back-link {
    display: inline-block;
    margin: 8px 0 18px;
    padding: 8px 14px;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 13px;
    color: rgba(248, 244, 232, 0.65);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .back-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* Stock pill — uses .product-stock-above-price colors from product-detail.css.
     The dot is a small visual decoration. */
  .product-stock-above-price {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }

  .product-stock-above-price .dot {
    font-size: 8px;
    line-height: 1;
  }

  /* Customization group spacing */
  .customization__group {
    margin-bottom: 14px;
  }

  /* Image fallback placeholder */
  .product-hero-image-placeholder {
    width: 100%;
    aspect-ratio: 1;
    max-width: 550px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 200px;
    color: rgba(255, 255, 255, 0.10);
    background: radial-gradient(
      circle at 50% 55%,
      rgba(78, 197, 122, 0.18),
      transparent 60%
    );
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.10);
  }

  .checkout-link {
    display: inline-block;
    margin-top: 12px;
    padding: 10px 18px;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    color: rgba(248, 244, 232, 0.85);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .checkout-link:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
  }

  /* YouTube video frame */
  .product-video-section {
    margin: var(--space-12) 0;
    padding: var(--space-12) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .product-video-section h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-3xl);
    color: var(--starry-white);
    text-align: center;
    margin: 0 0 var(--space-8);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .video-frame {
    max-width: 800px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.10);
  }

  .video-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ─── Parchment slab containing features + specs ─── */
  .specs-wrap {
    margin: var(--space-12) 0;
    display: flex;
    justify-content: center;
  }

  .specs-parchment {
    position: relative;
    background: linear-gradient(
      135deg,
      #fae5d0 0%,
      #f4dcc0 25%,
      #eed7b8 50%,
      #f4ddbc 75%,
      #f7dfc0 100%
    );
    border-radius: 12px;
    padding: 40px 44px;
    max-width: 820px;
    width: 100%;
    color: #2b160e;
    font-family: 'Crimson Pro', Georgia, serif;
    line-height: 1.7;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 2px 8px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    overflow: hidden;
  }

  .specs-parchment::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: radial-gradient(
      ellipse 75% 90% at center,
      transparent 35%,
      rgba(80, 50, 30, 0.10) 85%,
      rgba(60, 40, 25, 0.18) 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .specs-parchment > * {
    position: relative;
    z-index: 2;
  }

  /* Force every descendant to inherit parchment ink — the global body
     colour (--color-text, near-white) otherwise bleeds through. */
  .specs-parchment :global(*) {
    color: inherit;
  }

  .specs-parchment h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 30px;
    color: #2a1d12;
    margin: 0 0 8px;
    letter-spacing: 0.01em;
    text-align: left;
    text-shadow: none;
    border: none;
  }

  .specs-lead {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    color: #4a3420;
    font-size: 18px;
    margin: 0 0 22px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 36px;
    margin-top: 18px;
  }

  .feature-block h3 {
    font-family: 'Crimson Pro', Georgia, serif;
    font-weight: 700;
    font-size: 18px;
    color: #2a1d12;
    margin: 0 0 4px;
  }

  .feature-block p {
    font-size: 14.5px;
    line-height: 1.6;
    color: #2b160e;
    margin: 0;
  }

  .specs-list {
    margin-top: 30px;
    border-top: 1px dashed rgba(80, 50, 25, 0.30);
  }

  .specs-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px dashed rgba(80, 50, 25, 0.18);
    font-size: 14.5px;
  }

  .specs-row .k {
    color: #5d3a1e;
    font-weight: 600;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .specs-row .v {
    color: #2b160e;
    font-weight: 500;
  }

  .specs-seal {
    position: absolute;
    right: 30px;
    bottom: 30px;
    width: 46px;
    height: 46px;
    opacity: 0.30;
    color: #8b6235;
    z-index: 2;
  }

  /* ─── Parchment slab containing the markdown body ─── */
  .product-body-wrap {
    margin: var(--space-12) 0;
    display: flex;
    justify-content: center;
  }

  .product-body-parchment {
    position: relative;
    background: linear-gradient(
      135deg,
      #fae5d0 0%,
      #f4dcc0 25%,
      #eed7b8 50%,
      #f4ddbc 75%,
      #f7dfc0 100%
    );
    border-radius: 12px;
    padding: 40px 44px;
    max-width: 820px;
    width: 100%;
    color: #2b160e;
    font-family: 'Crimson Pro', Georgia, serif;
    line-height: 1.75;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    overflow: hidden;
  }

  .product-body-parchment::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: url('/assets/textures/paper-grain.webp');
    background-size: 300px;
    opacity: 0.18;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .product-body-content {
    position: relative;
    z-index: 1;
  }

  .product-body-parchment,
  .product-body-parchment :global(*) {
    color: #2b160e;
  }

  .product-body-content :global(h1),
  .product-body-content :global(h2),
  .product-body-content :global(h3) {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #2a1d12;
    letter-spacing: -0.01em;
  }

  .product-body-content :global(h2) {
    font-size: 26px;
    margin: 22px 0 10px;
  }

  .product-body-content :global(h3) {
    font-size: 20px;
    margin: 18px 0 8px;
  }

  .product-body-content :global(p) {
    font-size: 17px;
    line-height: 1.7;
    margin: 0 0 14px;
  }

  .product-body-content :global(a) {
    color: #1d5a3d;
    text-decoration: none;
    border-bottom: 1px dashed rgba(29, 90, 61, 0.4);
  }

  .product-body-content :global(a:hover) {
    color: #2a7a4f;
    border-bottom-color: #2a7a4f;
  }

  .product-body-content :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-size: 14px;
    background: rgba(80, 50, 25, 0.10);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .product-body-content :global(blockquote) {
    border-left: 3px solid rgba(80, 50, 25, 0.30);
    padding-left: 16px;
    margin: 18px 0;
    color: #4a3420;
    font-style: italic;
  }

  .product-body-content :global(ul),
  .product-body-content :global(ol) {
    margin: 0 0 14px 22px;
    padding: 0;
  }

  .product-body-content :global(li) {
    margin: 6px 0;
  }

  @media (max-width: 720px) {
    .specs-parchment,
    .product-body-parchment {
      padding: 28px 22px;
    }

    .feature-row {
      grid-template-columns: 1fr;
    }
  }
</style>
