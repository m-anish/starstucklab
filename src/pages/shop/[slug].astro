---
import { getCollection, render } from 'astro:content';
import StandardPageLayout from '../../layouts/StandardPageLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const {
  title,
  tagline,
  price,
  currency = 'INR',
  status,
  stock_status,
  lead_time,
  excerpt,
  features = [],
  customization,
  specifications = [],
  images,
  youtube_url,
} = product.data;

// Derive a clean YouTube embed URL from either a full URL or a bare video ID
function getYouTubeEmbed(raw: string | undefined): string | null {
  if (!raw) return null;
  const match = raw.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/);
  const videoId = match ? match[1] : (raw.length === 11 ? raw : null);
  return videoId ? `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1` : null;
}

const embedUrl = getYouTubeEmbed(youtube_url);

const isAvailable = status === 'available';
const isBuildToOrder = stock_status === 'build_to_order';
const isOutOfStock = stock_status === 'out_of_stock';
const isPreOrder = stock_status === 'pre_order';
const canAddToCart = isAvailable && !isOutOfStock;

function formatPrice(p: number, cur: string): string {
  if (cur === 'INR') return `₹${p.toLocaleString('en-IN')}`;
  return `${cur} ${p.toLocaleString()}`;
}

// Serialise product data for client-side cart script
const cartProduct = JSON.stringify({
  productSlug: product.slug,
  title,
  price: price ?? 0,
  customization: {},
});
---
<StandardPageLayout title={`${title} — Starstuck Lab`} description={excerpt} backgroundScene="shop">
  <main class="product-page">

    <!-- Hero: image + primary info -->
    <section class="product-hero container">
      <div class="product-hero__image-col">
        <div class="product-hero__image-frame">
          {images?.master ? (
            <img
              src={images.master}
              alt={title}
              class="product-hero__image"
              loading="eager"
            />
          ) : (
            <div class="product-hero__image-placeholder" aria-hidden="true">✦</div>
          )}
        </div>
      </div>

      <div class="product-hero__info-col">
        <div class="product-hero__badges">
          {isBuildToOrder && (
            <span class="badge badge--build">Build to Order</span>
          )}
          {isOutOfStock && (
            <span class="badge badge--out">Out of Stock</span>
          )}
          {isPreOrder && (
            <span class="badge badge--pre">Pre-Order</span>
          )}
          {!isAvailable && (
            <span class="badge badge--unavailable">Unavailable</span>
          )}
        </div>

        <h1 class="product-hero__title">{title}</h1>
        {tagline && <p class="product-hero__tagline">{tagline}</p>}

        {price && (
          <div class="product-hero__price-row">
            <span class="product-hero__price">{formatPrice(price, currency)}</span>
            {isBuildToOrder && lead_time && (
              <span class="product-hero__lead-time">Ships in {lead_time}</span>
            )}
          </div>
        )}

        <!-- Customization panel -->
        {customization?.enabled && customization.options && customization.options.length > 0 && (
          <div class="customization" id="customization-panel">
            {customization.options.map((option) => (
              <div class="customization__group">
                <label class="customization__label" for={`opt-${option.label}`}>
                  {option.label}
                </label>
                <div class="customization__swatches" role="group" aria-label={option.label} data-option={option.label}>
                  {option.values.map((value, i) => (
                    <button
                      type="button"
                      class:list={['customization__swatch', { 'customization__swatch--active': i === 0 }]}
                      data-value={value}
                      aria-pressed={i === 0}
                    >
                      {value}
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- Add to cart -->
        <div class="product-hero__actions">
          {canAddToCart ? (
            <button
              id="add-to-cart"
              class="btn btn--primary btn--full"
              data-product={cartProduct}
            >
              Add to Cart
            </button>
          ) : (
            <button class="btn btn--disabled btn--full" disabled>
              {isOutOfStock ? 'Out of Stock' : 'Unavailable'}
            </button>
          )}
          <a href="/checkout" class="btn btn--outline btn--full" id="checkout-link" hidden>
            Checkout →
          </a>
        </div>

        <p class="product-hero__guarantee">
          Handmade in India. Ships with full assembly instructions.
          Not responsible for the existential weight of seeing the Milky Way for the first time.
        </p>
      </div>
    </section>

    <!-- Features -->
    {features.length > 0 && (
      <section class="product-features container">
        <h2 class="section-title">Features</h2>
        <ul class="features-grid">
          {features.map((f) => (
            <li class="feature-card">
              <div class="feature-card__icon" aria-hidden="true">✦</div>
              <h3 class="feature-card__title">{f.title}</h3>
              <p class="feature-card__desc">{f.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Specs -->
    {specifications.length > 0 && (
      <section class="product-specs container">
        <h2 class="section-title">Specifications</h2>
        <table class="specs-table">
          <tbody>
            {specifications.map((spec) => (
              <tr class="specs-table__row">
                <th class="specs-table__label">{spec.label}</th>
                <td class="specs-table__value">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <!-- YouTube demo video -->
    {embedUrl && (
      <section class="product-video container">
        <h2 class="section-title">See it in the Wild</h2>
        <div class="video-frame">
          <iframe
            src={embedUrl}
            title={`${title} — video demo`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
    )}

    <!-- Body content -->
    <section class="product-body container">
      <div class="prose">
        <Content />
      </div>
    </section>

  </main>
</StandardPageLayout>

<script>
  // ── Cart logic ──────────────────────────────────────────────

  interface CartItem {
    productSlug: string;
    title: string;
    price: number;
    quantity: number;
    customization?: Record<string, string>;
  }

  function getCart(): CartItem[] {
    try { return JSON.parse(localStorage.getItem('cart') ?? '[]'); }
    catch { return []; }
  }

  function saveCart(cart: CartItem[]): void {
    localStorage.setItem('cart', JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cart:updated'));
  }

  function addToCart(item: Omit<CartItem, 'quantity'>): void {
    const cart = getCart();
    const key = JSON.stringify({ slug: item.productSlug, custom: item.customization });
    const existing = cart.find(
      (c) => JSON.stringify({ slug: c.productSlug, custom: c.customization }) === key
    );
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ ...item, quantity: 1 });
    }
    saveCart(cart);
  }

  // ── Customization swatches ──────────────────────────────────

  const selections: Record<string, string> = {};

  document.querySelectorAll('.customization__swatches').forEach((group) => {
    const optionName = (group as HTMLElement).dataset.option!;
    const buttons = group.querySelectorAll<HTMLButtonElement>('.customization__swatch');

    // Set initial selection
    if (buttons[0]) {
      selections[optionName] = buttons[0].dataset.value!;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('customization__swatch--active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('customization__swatch--active');
        btn.setAttribute('aria-pressed', 'true');
        selections[optionName] = btn.dataset.value!;
      });
    });
  });

  // ── Add to Cart button ──────────────────────────────────────

  const addBtn = document.getElementById('add-to-cart') as HTMLButtonElement | null;
  const checkoutLink = document.getElementById('checkout-link') as HTMLAnchorElement | null;

  addBtn?.addEventListener('click', () => {
    const productData = JSON.parse(addBtn.dataset.product!);
    addToCart({
      ...productData,
      customization: Object.keys(selections).length > 0 ? { ...selections } : undefined,
    });

    // Feedback
    addBtn.textContent = 'Added ✓';
    addBtn.classList.add('btn--added');
    if (checkoutLink) checkoutLink.hidden = false;

    setTimeout(() => {
      addBtn.textContent = 'Add to Cart';
      addBtn.classList.remove('btn--added');
    }, 2000);
  });
</script>

<style>
  .product-page {
    padding-bottom: var(--space-24);
  }

  /* ── Hero ── */
  .product-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .product-hero__image-frame {
    aspect-ratio: 1;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: sticky;
    top: calc(var(--navbar-height) + var(--space-4));
  }

  .product-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-hero__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--color-faint);
  }

  .product-hero__badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
    min-height: 1.75rem;
  }

  .product-hero__title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .product-hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-muted);
    font-style: italic;
    line-height: var(--leading-base);
    margin-bottom: var(--space-6);
  }

  .product-hero__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .product-hero__price {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
  }

  .product-hero__lead-time {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ── Badges ── */
  .badge {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .badge--build {
    background: rgba(201, 185, 122, 0.12);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-dim);
  }

  .badge--out {
    background: rgba(192, 57, 43, 0.1);
    color: var(--color-danger);
    border: 1px solid rgba(192, 57, 43, 0.3);
  }

  .badge--pre {
    background: rgba(100, 149, 237, 0.1);
    color: cornflowerblue;
    border: 1px solid rgba(100, 149, 237, 0.3);
  }

  .badge--unavailable {
    background: rgba(136, 136, 153, 0.1);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  /* ── Customization ── */
  .customization {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .customization__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .customization__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .customization__swatch {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    background: transparent;
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .customization__swatch:hover {
    border-color: var(--color-muted);
    color: var(--color-text);
  }

  .customization__swatch--active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(201, 185, 122, 0.08);
  }

  /* ── Actions ── */
  .product-hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .product-hero__guarantee {
    font-size: var(--text-xs);
    color: var(--color-faint);
    line-height: var(--leading-base);
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid currentColor;
    border-radius: var(--radius-md);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast);
    font-family: inherit;
  }

  .btn--full { width: 100%; }

  .btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .btn--primary:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .btn--added {
    background: var(--color-success) !important;
    border-color: var(--color-success) !important;
    color: #fff !important;
  }

  .btn--outline {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn--outline:hover {
    border-color: var(--color-text);
  }

  .btn--disabled {
    background: var(--color-surface-2);
    color: var(--color-muted);
    border-color: var(--color-border);
    cursor: not-allowed;
    opacity: 0.7;
  }

  /* ── Features ── */
  .product-features {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-8);
    letter-spacing: -0.01em;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .feature-card {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .feature-card__icon {
    color: var(--color-accent);
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .feature-card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
    line-height: var(--leading-tight);
  }

  .feature-card__desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-base);
  }

  /* ── Specs ── */
  .product-specs {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .specs-table {
    width: 100%;
    max-width: 560px;
    border-collapse: collapse;
  }

  .specs-table__row {
    border-bottom: 1px solid var(--color-border);
  }

  .specs-table__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-muted);
    text-align: left;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    width: 40%;
    vertical-align: top;
  }

  .specs-table__value {
    font-size: var(--text-sm);
    padding: var(--space-3) 0;
    color: var(--color-text);
  }

  /* ── YouTube video ── */
  .product-video {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .video-frame {
    position: relative;
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16/9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ── Body ── */
  .product-body {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .product-hero {
      grid-template-columns: 1fr;
    }

    .product-hero__image-frame {
      position: static;
    }

    .product-hero__title {
      font-size: var(--text-4xl);
    }
  }
</style>
