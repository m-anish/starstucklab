---
import StandardPageLayout from '../layouts/StandardPageLayout.astro';

// Retrieve Stripe session details server-side if session_id is present
const sessionId = Astro.url.searchParams.get('session_id');
let orderRef = sessionId ? sessionId.slice(-8).toUpperCase() : null;
---
<StandardPageLayout title="Order received — Starstuck Lab" description="The workshop has received your order." backgroundScene="workshop">
  <main class="order-page">
    {sessionId ? (
      <article class="order-card">
        <div class="order-icon" aria-hidden="true">✦</div>
        <h1>Order received.</h1>
        <p class="order-ref">Reference: <code>{orderRef}</code></p>
        <p class="order-msg">
          A confirmation email is on its way. The workshop will start building your order and reach out when it's ready to ship.
        </p>
        <p class="order-lead">
          Most orders ship within 2–3 weeks. Any change in plan will be mentioned in good time.
        </p>
        <div class="order-actions">
          <a href="/machines" class="btn-ord btn-ord-fill">Back to the machines</a>
          <a href="/lab" class="btn-ord btn-ord-ghost">Read the Lab Notes</a>
        </div>
      </article>
    ) : (
      <article class="order-card order-card--empty">
        <h1>Nothing to confirm here.</h1>
        <p>This page is reached after a completed checkout. To see what the lab makes, head to the <a href="/machines">machines</a>.</p>
      </article>
    )}
  </main>
</StandardPageLayout>

<script>
  // Clear cart on successful order. Cart lives under `starstucklab_cart`.
  if (new URLSearchParams(window.location.search).get('session_id')) {
    localStorage.removeItem('starstucklab_cart');
    window.dispatchEvent(new CustomEvent('cart:updated'));
  }
</script>

<style>
  .order-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 90px 24px 80px;
    position: relative;
    z-index: 1;
  }

  .order-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    backdrop-filter: blur(14px) saturate(1.05);
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
    padding: 56px 40px;
    text-align: center;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .order-icon {
    font-size: 3rem;
    color: #f8f4e8;
    display: block;
    margin-bottom: 24px;
  }

  .order-card h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #f8f4e8;
    margin: 0 0 16px;
  }

  .order-ref {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 13px;
    color: rgba(248, 244, 232, 0.62);
    margin: 0 0 28px;
  }

  .order-ref code {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 3px 8px;
    border-radius: 3px;
    color: #f8f4e8;
  }

  .order-msg {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(248, 244, 232, 0.88);
    margin: 0 0 16px;
  }

  .order-lead {
    font-family: 'Merriweather', Georgia, serif;
    font-style: italic;
    color: rgba(248, 244, 232, 0.62);
    font-size: 14px;
    margin: 0 0 36px;
  }

  .order-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-ord {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    border: 2px solid;
    border-radius: 4px;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }

  .btn-ord-fill {
    background: #f8f4e8;
    color: #0c0c0e;
    border-color: #f8f4e8;
  }

  .btn-ord-fill:hover {
    background: transparent;
    color: #f8f4e8;
  }

  .btn-ord-ghost {
    background: transparent;
    color: rgba(248, 244, 232, 0.72);
    border-color: rgba(248, 244, 232, 0.45);
  }

  .btn-ord-ghost:hover {
    color: #f8f4e8;
    border-color: #f8f4e8;
  }

  .order-card--empty {
    padding: 40px;
  }

  .order-card--empty p {
    font-family: 'Crimson Pro', Georgia, serif;
    color: rgba(248, 244, 232, 0.7);
    font-size: 16px;
  }

  .order-card--empty a {
    color: #4ec57a;
    border-bottom: 1px dashed rgba(78, 197, 122, 0.4);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .order-card {
      padding: 40px 24px;
    }

    .order-card h1 {
      font-size: 34px;
    }
  }
</style>
