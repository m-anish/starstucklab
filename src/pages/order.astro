---
import BaseLayout from '../layouts/BaseLayout.astro';

// Retrieve Stripe session details server-side if session_id is present
const sessionId = Astro.url.searchParams.get('session_id');
let orderRef = sessionId ? sessionId.slice(-8).toUpperCase() : null;
---
<BaseLayout title="Order Confirmed — Starstuck Lab" description="Your order has been received">
  <main class="order-page">
    {sessionId ? (
      <div class="order-page__success">
        <div class="order-page__icon" aria-hidden="true">✦</div>
        <h1>Order received.</h1>
        <p class="order-page__ref">Reference: <code>{orderRef}</code></p>
        <p class="order-page__message">
          You'll receive a confirmation email shortly.
          We'll start building your order and reach out when it's ready to ship.
        </p>
        <p class="order-page__lead-time">
          Most orders ship within 2–3 weeks. We'll be in touch if anything changes.
        </p>
        <div class="order-page__actions">
          <a href="/shop" class="btn btn--outline">Back to Shop</a>
          <a href="/lab" class="btn btn--ghost">Read the Lab Notes</a>
        </div>
      </div>
    ) : (
      <div class="order-page__empty">
        <h1>Nothing to see here.</h1>
        <p>This page is for confirming orders. If you meant to check out, try the <a href="/shop">shop</a>.</p>
      </div>
    )}
  </main>
</BaseLayout>

<script>
  // Clear cart on successful order
  if (new URLSearchParams(window.location.search).get('session_id')) {
    localStorage.removeItem('cart');
    // Dispatch event so any open cart drawer updates
    window.dispatchEvent(new CustomEvent('cart:updated'));
  }
</script>

<style>
  .order-page {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-4);
    text-align: center;
  }

  .order-page__icon {
    font-size: 3rem;
    margin-bottom: var(--space-6);
    display: block;
  }

  .order-page__success h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .order-page__ref {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .order-page__ref code {
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
  }

  .order-page__message {
    font-size: var(--text-lg);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .order-page__lead-time {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-10);
  }

  .order-page__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border: 2px solid currentColor;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .btn--outline {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .btn--outline:hover {
    background: transparent;
    color: var(--color-text);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-muted);
    border-color: var(--color-muted);
  }

  .btn--ghost:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }
</style>
