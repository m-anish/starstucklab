---
import StandardPageLayout from '../layouts/StandardPageLayout.astro';
---
<StandardPageLayout
  title="About — Starstuck Lab"
  description="A quiet hillside workshop where ideas drift between solder smoke, old wood, and soft starlight."
  backgroundScene="shop"
>
  <main class="about-page">
    <article class="parchment about-parchment" data-surface="parchment">
      <h1>About the workshop</h1>
      <p class="motto">Building small machines for an indifferent universe.</p>

      <p>
        A quiet hillside workshop where ideas drift between solder smoke,
        old wood, soft starlight, and dry cosmic humour. Sketches curl at the
        edges. Machines attempt usefulness, sometimes succeed.
      </p>

      <p>
        Everything here is made one at a time. Each piece resolves with a small
        note explaining what went wrong on the way to working. Trees have
        strong opinions about 868 MHz, and the radiation shield warped in the
        sun, teaching that PLA believes in heat death on a very local scale.
      </p>

      <p>
        Lead times depend on weather and mood. There is no roadmap, only a
        list, and the list is getting shorter, slowly.
      </p>

      <svg class="about-seal" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
        <path d="M50 4l11 32 33 1-27 19 10 32L50 70 23 88l10-32L6 37l33-1z" />
      </svg>
    </article>
  </main>
</StandardPageLayout>

<style>
  .about-page {
    padding: 120px 24px 60px;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .about-parchment {
    position: relative;
    max-width: 680px;
    width: 100%;
    padding: 48px 52px;
    background: linear-gradient(
      135deg,
      #fae5d0 0%,
      #f4dcc0 25%,
      #eed7b8 50%,
      #f4ddbc 75%,
      #f7dfc0 100%
    );
    border-radius: 12px;
    color: #2b160e;
    font-family: 'Crimson Pro', Georgia, serif;
    line-height: 1.75;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 2px 8px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    overflow: hidden;
  }

  /* Coffee stain — the only sanctioned decoration on the about card */
  .about-parchment::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: url('/assets/textures/coffee-stain.png') no-repeat;
    background-size: 220px auto;
    background-position: 88% 88%;
    mix-blend-mode: multiply;
    opacity: 0.4;
    pointer-events: none;
  }

  /* Paper-grain darken vignette */
  .about-parchment::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: radial-gradient(
      ellipse 75% 90% at center,
      transparent 35%,
      rgba(80, 50, 30, 0.10) 85%,
      rgba(60, 40, 25, 0.18) 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .about-parchment > * {
    position: relative;
    z-index: 2;
  }

  .about-parchment h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 38px;
    line-height: 1.1;
    color: #2a1d12;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .about-parchment .motto {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    color: #4a3420;
    font-size: 18px;
    margin: 0 0 22px;
  }

  .about-parchment p {
    font-size: 16px;
    color: #2b160e;
    line-height: 1.75;
    margin: 0 0 14px;
  }

  .about-seal {
    position: absolute;
    right: 28px;
    bottom: 24px;
    width: 48px;
    height: 48px;
    opacity: 0.30;
    color: #8b6235;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .about-page {
      padding: 90px 16px 50px;
    }

    .about-parchment {
      padding: 32px 24px;
    }

    .about-parchment h1 {
      font-size: 30px;
    }
  }
</style>
