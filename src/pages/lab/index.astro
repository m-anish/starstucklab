---
import { getCollection } from 'astro:content';
import StandardPageLayout from '../../layouts/StandardPageLayout.astro';

const allNotes = await getCollection('lab-notes');

const notes = allNotes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Lab-note date format: "2026 . 08 . 04" (matches the design system's mono date)
function formatLabDate(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y} . ${m} . ${d}`;
}

function readTimeFromExcerpt(excerpt: string | undefined): string {
  if (!excerpt) return '2 min read';
  const words = excerpt.split(/\s+/).length;
  // Excerpts are short; assume the full piece is 6× the excerpt size at ~220wpm
  const minutes = Math.max(2, Math.round((words * 6) / 220));
  return `${minutes} min read`;
}
---
<StandardPageLayout
  title="Lab Notes — Starstuck Lab"
  description="Build logs, dead ends, and the occasional small triumph from a one-person workshop."
  backgroundScene="shop"
>
  <main class="lab-page">
    <div class="lab-wrap">
      <header class="lab-head">
        <h1>Lab Notes</h1>
        <p>
          What went wrong on the way to working. Build logs, dead ends, and the
          occasional small triumph, written down so the next attempt has somewhere to start.
        </p>
      </header>
      <div class="lab-divider"></div>

      {notes.length === 0 && (
        <p class="lab-empty-note">Nothing written yet. Probably still in the lab.</p>
      )}

      <div class="lab-list">
        {notes.map((note) => (
          <a href={`/lab/${note.slug}`} class="lab-card-link">
            <article class="lab-card">
              <div class="lab-meta">
                <span class="date">{formatLabDate(note.data.date)}</span>
                {note.data.tags && note.data.tags.length > 0 && (
                  <span class="tag">{note.data.tags[0]}</span>
                )}
              </div>
              <h2>{note.data.title}</h2>
              <p class="lab-excerpt">{note.data.excerpt}</p>
              <div class="lab-foot">
                <span>{readTimeFromExcerpt(note.data.excerpt)}</span>
                <span class="read-more">Continue reading →</span>
              </div>
            </article>
          </a>
        ))}
      </div>

      <p class="lab-empty-note">
        Older entries archived in a paper notebook on the workbench.
      </p>
    </div>
  </main>
</StandardPageLayout>

<style>
  .lab-page {
    position: relative;
    z-index: 1;
  }

  .lab-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 90px 24px 80px;
  }

  /* ── Header ── */
  .lab-head {
    margin-bottom: 32px;
  }

  .lab-head h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 46px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f8f4e8;
    margin: 0 0 8px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .lab-head p {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    color: rgba(248, 244, 232, 0.72);
    font-size: 18px;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    max-width: 50ch;
    line-height: 1.55;
  }

  .lab-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(248, 244, 232, 0.30), transparent);
    margin: 28px 0 24px;
  }

  /* ── Card list ── */
  .lab-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .lab-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .lab-card {
    background: linear-gradient(
      135deg,
      #fae5d0 0%,
      #f4dcc0 25%,
      #eed7b8 50%,
      #f4ddbc 75%,
      #f7dfc0 100%
    );
    border-radius: 12px;
    padding: 30px 34px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .lab-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/assets/textures/paper-grain.webp');
    background-size: 300px;
    opacity: 0.18;
    mix-blend-mode: multiply;
    pointer-events: none;
    border-radius: 12px;
  }

  .lab-card > * {
    position: relative;
    z-index: 1;
  }

  .lab-card-link:hover .lab-card {
    transform: translateY(-3px);
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(0, 0, 0, 0.10);
  }

  /* ── Meta ── */
  .lab-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: #5d3a1e;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .lab-meta .date {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .lab-meta .tag {
    padding: 3px 8px;
    background: rgba(80, 50, 25, 0.10);
    border: 1px solid rgba(80, 50, 25, 0.18);
    border-radius: 9999px;
    font-size: 10.5px;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .lab-card h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #2a1d12;
    margin: 0 0 8px;
    text-wrap: balance;
  }

  .lab-excerpt {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 17px;
    line-height: 1.65;
    color: #3d2515;
    margin: 0 0 14px;
    text-wrap: pretty;
  }

  .lab-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px dashed rgba(80, 50, 25, 0.25);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 12px;
    color: #5d3a1e;
  }

  .lab-foot .read-more {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #2a7a4f;
    transition: color 0.15s ease;
  }

  .lab-card-link:hover .read-more {
    color: #1d5a3d;
  }

  .lab-empty-note {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    color: rgba(248, 244, 232, 0.55);
    font-size: 14px;
    text-align: center;
    padding-top: 30px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 640px) {
    .lab-wrap {
      padding: 70px 16px 60px;
    }

    .lab-card {
      padding: 22px 24px;
    }

    .lab-head h1 {
      font-size: 36px;
    }

    .lab-card h2 {
      font-size: 22px;
    }
  }
</style>
