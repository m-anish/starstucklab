---
// src/components/CustomizationPanel.astro
import ColorPicker from './customization/ColorPicker.astro';
import TextInput from './customization/TextInput.astro';
import NumberInput from './customization/NumberInput.astro';
import SelectInput from './customization/SelectInput.astro';
import CheckboxInput from './customization/CheckboxInput.astro';
import RadioInput from './customization/RadioInput.astro';

const { product } = Astro.props;
const customization = product.customization;

if (!customization?.enabled || !customization?.options?.length) {
  return null;
}

const hasCustomization = customization.options.length > 0;
---

{hasCustomization && (
  <div class="customization-panel-wrapper" data-product-slug={product.slug}>
    <button type="button" class="customize-toggle" id="customizeToggle">
      <span class="toggle-icon">✨</span>
      <span class="toggle-text">
        <strong>Make it yours</strong>
        <small>Standard build · Customize colors & options</small>
      </span>
      <span class="toggle-arrow">▼</span>
    </button>
    
    <div class="customization-panel" id="customizationPanel" data-expanded="false">
      <div class="panel-header">
        <h3>Customize Your {product.title}</h3>
        <button type="button" class="panel-close" id="panelClose" aria-label="Close customization">
          ✕
        </button>
      </div>
      
      <div class="panel-body">
        <div class="customization-options">
          {customization.options.map((option: any) => {
            switch (option.type) {
              case 'color_picker':
                return <ColorPicker option={option} />;
              case 'text':
                return <TextInput option={option} />;
              case 'number':
                return <NumberInput option={option} />;
              case 'select':
                return <SelectInput option={option} />;
              case 'checkbox':
                return <CheckboxInput option={option} />;
              case 'radio':
                return <RadioInput option={option} />;
              default:
                return null;
            }
          })}
        </div>
        
        <!-- Price Breakdown -->
        <div class="price-breakdown">
          <div class="breakdown-line base-price">
            <span>Base price:</span>
            <span id="basePriceDisplay">{product.currency} {product.price.toLocaleString()}</span>
          </div>
          
          <div id="additionalCosts" class="additional-costs"></div>
          
          <div class="breakdown-divider"></div>
          
          <div class="breakdown-line total-price">
            <strong>Your price:</strong>
            <strong id="totalPriceDisplay">{product.currency} {product.price.toLocaleString()}</strong>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Hidden data for script -->
    <script type="application/json" id="customizationData">
      {JSON.stringify({
        basePrice: product.price,
        currency: product.currency,
        options: customization.options
      })}
    </script>
  </div>
)}

<style>
  .customization-panel-wrapper {
    margin: var(--space-6) 0;
  }
  
  /* Toggle Button */
  .customize-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: rgba(42, 122, 79, 0.08);
    border: 1.5px solid rgba(42, 122, 79, 0.25);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: all var(--transition-base);
  }
  
  .customize-toggle:hover {
    background: rgba(42, 122, 79, 0.12);
    border-color: rgba(42, 122, 79, 0.4);
    transform: translateY(-1px);
  }
  
  .toggle-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  
  .toggle-text {
    flex: 1;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  
  .toggle-text strong {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink-dark);
  }
  
  .toggle-text small {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  
  .toggle-arrow {
    flex-shrink: 0;
    color: var(--ink-mid);
    transition: transform var(--transition-base);
  }
  
  .customize-toggle[aria-expanded="true"] .toggle-arrow {
    transform: rotate(180deg);
  }
  
  /* Panel */
  .customization-panel {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease;
    margin-top: var(--space-4);
  }
  
  .customization-panel[data-expanded="true"] {
    max-height: 2000px; /* Large enough for content */
    opacity: 1;
  }
  
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid rgba(80, 50, 25, 0.15);
  }
  
  .panel-header h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink-dark);
    margin: 0;
  }
  
  .panel-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--ink-mid);
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }
  
  .panel-close:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--ink-dark);
  }
  
  .panel-body {
    padding: var(--space-5);
    background: rgba(255, 250, 240, 0.6);
    border-radius: var(--radius-xl);
  }
  
  .customization-options {
    margin-bottom: var(--space-8);
  }
  
  /* Price Breakdown */
  .price-breakdown {
    padding: var(--space-5);
    background: rgba(255, 255, 255, 0.8);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(80, 50, 25, 0.15);
  }
  
  .breakdown-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-mid);
  }
  
  .breakdown-line.base-price {
    color: var(--ink-muted);
  }
  
  .additional-costs {
    margin: var(--space-2) 0;
  }
  
  .additional-costs .breakdown-line {
    color: var(--accent-green);
    font-weight: 500;
  }
  
  .breakdown-divider {
    height: 1px;
    background: rgba(80, 50, 25, 0.15);
    margin: var(--space-4) 0;
  }
  
  .breakdown-line.total-price {
    font-size: var(--text-lg);
    color: var(--ink-dark);
    padding-top: var(--space-3);
  }
  
  @media (max-width: 640px) {
    .customize-toggle {
      padding: var(--space-3) var(--space-4);
    }
    
    .panel-body {
      padding: var(--space-4);
    }
    
    .price-breakdown {
      padding: var(--space-4);
    }
  }
</style>

<script>
  import { calculatePrice, initializeValues } from '../lib/pricing';
  
  const wrapper = document.querySelector('.customization-panel-wrapper');
  if (!wrapper) throw new Error('Customization wrapper not found');
  
  const toggle = document.getElementById('customizeToggle') as HTMLButtonElement;
  const panel = document.getElementById('customizationPanel') as HTMLDivElement;
  const closeBtn = document.getElementById('panelClose') as HTMLButtonElement;
  const dataEl = document.getElementById('customizationData') as HTMLScriptElement;
  
  // Load configuration
  const config = JSON.parse(dataEl.textContent || '{}');
  const { basePrice, currency, options } = config;
  
  // Initialize values
  const currentValues = initializeValues(options);
  
  // Toggle panel
  function togglePanel() {
    const isExpanded = panel.dataset.expanded === 'true';
    panel.dataset.expanded = isExpanded ? 'false' : 'true';
    toggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
  }
  
  toggle.addEventListener('click', togglePanel);
  closeBtn.addEventListener('click', togglePanel);
  
  // Update pricing
  function updatePricing() {
    const breakdown = calculatePrice(basePrice, currency, options, currentValues);
    
    // Update additional costs
    const additionalCosts = document.getElementById('additionalCosts')!;
    if (breakdown.items.length > 0) {
      additionalCosts.innerHTML = breakdown.items.map(item => 
        `<div class="breakdown-line">
          <span>${item.label}:</span>
          <span>+${currency} ${item.amount.toLocaleString()}</span>
        </div>`
      ).join('');
    } else {
      additionalCosts.innerHTML = '';
    }
    
    // Update total
    document.getElementById('totalPriceDisplay')!.textContent = 
      `${currency} ${breakdown.total.toLocaleString()}`;
    
    // Update CTA button if exists
    const ctaButton = document.querySelector('.add-to-cart-btn') as HTMLElement;
    if (ctaButton) {
      const priceSpan = ctaButton.querySelector('#ctaPrice');
      if (priceSpan) {
        priceSpan.textContent = `${currency} ${breakdown.total.toLocaleString()}`;
      }
    }
    
    // Store for cart
    wrapper.setAttribute('data-total-price', breakdown.total.toString());
    wrapper.setAttribute('data-customization', JSON.stringify(currentValues));
  }
  
  // Listen for changes
  panel.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const optionId = target.dataset.optionId;
    
    if (!optionId) return;
    
    // Update value
    if (target.type === 'checkbox') {
      currentValues[optionId] = target.checked;
    } else {
      currentValues[optionId] = target.value;
    }
    
    // Recalculate
    updatePricing();
  });
  
  // Initial calculation
  updatePricing();
</script>