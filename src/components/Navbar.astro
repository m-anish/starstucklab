---
// src/components/Navbar.astro
// Slim black navbar: star logo + wordmark left, nav links right, cart badge
import { getNavigation } from '../lib/navigation';
import CartBadge from './CartBadge.astro';

const navData = getNavigation();
const rawItems = navData.primary;
const settings = navData.settings;

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

function resolveHref(href: string): string {
  if (!href) return base;
  if (/^(https?:)?\/\//.test(href) || href.startsWith('mailto:')) return href;
  const trimmed = href.startsWith('/') ? href.slice(1) : href;
  return base + trimmed;
}

const navItems = rawItems.map((item) => ({
  ...item,
  resolvedHref: resolveHref(item.href),
}));
---

<header class="navbar" role="banner">
  <div class="navbar__inner">
    <!-- Logo / wordmark -->
    <a href={base} class="navbar__brand" aria-label="Starstuck Lab home">
      <img
        src={`${base}assets/icons/starstucklab_logo_black_white.svg`}
        alt="Starstuck Lab star logo"
        class="navbar__logo-img"
        width="28"
        height="28"
      />
      <span class="navbar__wordmark">{settings.logoText}</span>
    </a>

    <!-- Primary nav links -->
    <nav class="navbar__nav" aria-label="Primary navigation">
      <ul class="navbar__links">
        {navItems.map((item) => (
          <li>
            <a href={item.resolvedHref} class="navbar__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right actions: cart -->
    <div class="navbar__actions">
      <CartBadge />
    </div>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--navbar-height);
    background: rgba(8, 6, 4, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(201, 185, 122, 0.1);
    z-index: var(--z-sticky);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    gap: var(--space-4);
  }

  /* ── Brand ── */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__logo-img {
    width: 28px;
    height: 28px;
    display: block;
    /* Invert to make it white on dark navbar */
    filter: invert(1);
  }

  .navbar__wordmark {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
  }

  /* ── Nav links ── */
  .navbar__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .navbar__link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: rgba(237, 237, 238, 0.75);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .navbar__link:hover {
    color: var(--color-text);
  }

  /* ── Actions ── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  /* ── Mobile: compact nav links (keep wordmark hidden to save space) ── */
  @media (max-width: 640px) {
    .navbar__wordmark {
      display: none;
    }

    .navbar__links {
      gap: var(--space-2); /* 8px — tight but legible at small font */
    }

    .navbar__link {
      font-size: 0.75rem; /* 12px — fits 3 links + cart badge + future icon */
    }
  }
</style>
