---
// src/components/Navbar.astro
// Slim black navbar: star logo + wordmark left, nav links right, cart badge
import { getNavigation } from '../lib/navigation';
import CartBadge from './CartBadge.astro';

const navData = getNavigation();
const rawItems = navData.primary;
const settings = navData.settings;

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

function resolveHref(href: string): string {
  if (!href) return base;
  if (/^(https?:)?\/\//.test(href) || href.startsWith('mailto:')) return href;
  const trimmed = href.startsWith('/') ? href.slice(1) : href;
  return base + trimmed;
}

const navItems = rawItems.map((item) => ({
  ...item,
  resolvedHref: resolveHref(item.href),
}));
---

<header class="navbar" role="banner">
  <div class="navbar__inner">
    <!-- Logo / wordmark -->
    <a href={base} class="navbar__brand" aria-label="Starstuck Lab home">
      <img
        src={`${base}assets/icons/starstucklab_logo_light.svg`}
        alt="Starstuck Lab star logo"
        class="navbar__logo-img"
        width="28"
        height="28"
      />
      <span class="navbar__wordmark">{settings.logoText}</span>
    </a>

    <!-- Primary nav links -->
    <nav class="navbar__nav" aria-label="Primary navigation">
      <ul class="navbar__links">
        {navItems.map((item) => (
          <li>
            <a href={item.resolvedHref} class="navbar__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right actions: cart trigger with badge overlay -->
    <div class="navbar__actions">
      <button class="navbar__cart" id="navbarCart" aria-label="Open cart" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 4h2l2.4 11.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.5L21 8H6"/>
          <circle cx="9" cy="20" r="1.4"/>
          <circle cx="18" cy="20" r="1.4"/>
        </svg>
        <CartBadge />
      </button>
    </div>
  </div>
</header>

<script>
  // Wire the navbar cart icon to open the global cart drawer.
  (function () {
    if (typeof window === 'undefined') return;
    const btn = document.getElementById('navbarCart');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const openCart = (window as any).openCart;
      if (typeof openCart === 'function') openCart();
    });
  })();
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--navbar-height);
    /* Translucent so the painted scene shows through, per design system. */
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    z-index: var(--z-sticky);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    gap: var(--space-4);
  }

  /* ── Brand ── */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__logo-img {
    width: 28px;
    height: 28px;
    display: block;
    /* The light variant is already white on transparent, no filter needed. */
  }

  .navbar__wordmark {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
  }

  /* ── Nav links ── */
  .navbar__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .navbar__link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    letter-spacing: 0.03em;
    padding: 6px 12px;
    border-radius: 6px;
    transition: background var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  .navbar__link:hover,
  .navbar__link.active {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* ── Actions ── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  /* Cart trigger: icon button with badge overlay */
  .navbar__cart {
    position: relative;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .navbar__cart:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* ── Mobile: compact nav links (keep wordmark hidden to save space) ── */
  @media (max-width: 640px) {
    .navbar__wordmark {
      display: none;
    }

    .navbar__links {
      gap: var(--space-2); /* 8px — tight but legible at small font */
    }

    .navbar__link {
      font-size: 0.75rem; /* 12px — fits 3 links + cart badge + future icon */
    }
  }
</style>
