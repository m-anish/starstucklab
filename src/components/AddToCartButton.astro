---
// site/src/components/AddToCartButton.astro
const { product } = Astro.props;
---

<button 
  class="add-to-cart-btn" 
  data-slug={product.slug}
  data-title={product.title}
  data-price={product.price}
  data-currency={product.currency || 'INR'}
>
  Add to Cart
</button>

<script>
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      const title = btn.getAttribute('data-title');
      const price = btn.getAttribute('data-price');
      const currency = btn.getAttribute('data-currency');
      
      if (!slug || !title || !price) return;
      
      try {
        const stored = localStorage.getItem('starstucklab_cart');
        const data = stored ? JSON.parse(stored) : { items: [] };
        const existingIndex = data.items.findIndex((i: any) => i.slug === slug);
        
        if (existingIndex >= 0) {
          data.items[existingIndex].quantity += 1;
        } else {
          data.items.push({ slug, title, price, currency: currency || 'INR', quantity: 1 });
        }
        
        const expiry = new Date();
        expiry.setDate(expiry.getDate() + 30);
        data.expiry = expiry.toISOString();
        
        localStorage.setItem('starstucklab_cart', JSON.stringify(data));
        window.dispatchEvent(new CustomEvent('cart:updated', { detail: { items: data.items } }));
        
        // Visual feedback
        const originalText = btn.textContent;
        btn.textContent = 'Added!';
        btn.disabled = true;
        
        // Open cart drawer
        if ((window as any).openCart) {
          setTimeout(() => {
            (window as any).openCart();
          }, 300);
        }
        
        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
        }, 2000);
      } catch (err) {
        console.error('Error adding to cart:', err);
        alert('Error adding to cart. Please try again.');
      }
    });
  });
</script>

<style>
  .add-to-cart-btn {
    padding: 12px 24px;
    background: linear-gradient(135deg, #2a7a4f 0%, #1d5a3d 100%);
    border: 1.5px solid #2a7a4f;
    border-radius: var(--radius-lg, 8px);
    color: #fff;
    font-size: var(--text-base, 1rem);
    font-weight: var(--weight-medium, 500);
    cursor: pointer;
    transition: all var(--transition-base, 250ms ease);
    font-family: var(--font-ui, 'Space Grotesk', sans-serif);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }
  
  .add-to-cart-btn:hover:not(:disabled) {
    background: linear-gradient(135deg, #1d5a3d 0%, #2a7a4f 100%);
    border-color: #1d5a3d;
    transform: translateY(-2px);
    box-shadow: 0 5px 14px rgba(0, 0, 0, 0.28);
  }
  
  .add-to-cart-btn:active:not(:disabled) {
    transform: translateY(0);
  }
  
  .add-to-cart-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>

