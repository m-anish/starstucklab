---
// src/components/ProductNav.astro
// Product-specific sticky navigation bar (appears below main navbar)
import "../styles/components/product-nav.css";

interface Props {
  product: {
    slug: string;
    title: string;
  };
}

const { product } = Astro.props;
---

<nav class="product-nav" id="productNav">
  <div class="product-nav-inner">
    <!-- Product Brand/Logo Section -->
    <div class="product-brand">
      <svg width="32" height="32" viewBox="0 0 1024 1024" fill="currentColor">
        <path d="M507.568 104.147C530.003 102.508 536.494 114.979 544.499 132.84C548.221 141.145 552.444 149.705 556.214 158.05L611.408 282.629L625.321 313.573C628.126 319.778 630.863 325.835 633.939 331.919C650.864 365.394 686.088 360.647 718.356 363.059L834.568 371.92L874.611 374.424C892.774 375.529 914.254 373.974 922.244 394.207C930.057 413.994 917.595 426.311 903.386 437.781C896.609 443.252 889.583 449.426 882.908 455.089L806.756 520.404L772.419 550.058C763.493 557.79 754.582 565.841 745.789 573.637C722.282 594.476 726.692 615.526 732.585 643.578C735.314 656.404 738.118 669.215 740.998 682.009L770.138 809.769C775.126 831.254 789.856 866.969 767.623 881.409C745.899 895.52 722.462 873.779 704.27 863.015L587.824 793.186C576.004 786.204 564.119 779.333 552.171 772.572C541.996 766.764 528.935 758.203 517.451 756.233L516.736 756.116C500.546 754.836 482.104 767.084 468.254 774.976C413.794 806.011 359.889 838.446 306.472 871.254C298.032 876.438 289.626 882.687 279.905 885.122C263.444 890.611 243.925 874.129 244.267 857.433C244.559 843.158 251.086 820.419 254.436 806.008C264.016 765.222 273.202 724.344 281.992 683.38L290.48 645.38C293.465 632.055 297.712 617.086 295.505 603.478C294.198 595.797 291.02 588.557 286.252 582.395C280.362 574.828 270.666 566.698 263.286 560.277L238.688 538.89L142.677 455.718L121.157 437.171C116.368 433.034 111.413 429.115 107.242 424.237C93.135 407.74 101 381.182 122.365 376.114C130.863 374.098 139.067 373.917 147.786 373.341L180.053 371.282C219.366 368.911 257.457 365.573 296.594 362.765C307.155 362.028 317.725 361.418 328.3 360.933C335.906 360.556 345.135 360.31 352.491 358.941C365.442 356.423 377.04 349.295 385.134 338.877C391.683 330.576 401.067 306.861 406.111 295.771C423.283 258.601 440.101 221.267 456.56 183.776C462.897 168.992 469.332 154.25 475.865 139.552C483.09 123.541 488.12 107.583 507.568 104.147Z"/>
      </svg>
      <span class="product-brand-text">STARSTUCK</span>
    </div>

    <!-- Product-Specific Links -->
    <div class="product-nav-links">
      <a href="#features" class="product-nav-link">Features</a>
      <a href="#specifications" class="product-nav-link">Specifications</a>
      <a href="#reviews" class="product-nav-link">Reviews</a>
    </div>
  </div>
</nav>

<script>
  // Sticky behavior for product nav (appears below main nav)
  if (typeof window !== 'undefined') {
    const productNav = document.getElementById('productNav');
    const mainNav = document.querySelector('.site-nav');
    
    if (productNav && mainNav) {
      const mainNavHeight = mainNav.offsetHeight;
      
      window.addEventListener('scroll', () => {
        if (window.scrollY > 100) {
          productNav.classList.add('is-sticky');
          productNav.style.top = `${mainNavHeight}px`;
        } else {
          productNav.classList.remove('is-sticky');
          productNav.style.top = '0';
        }
      }, { passive: true });
    }

    // Smooth scroll to sections
    const links = document.querySelectorAll('.product-nav-link');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.slice(1);
        if (!targetId) return;
        
        const target = document.getElementById(targetId);
        if (target) {
          const mainNavHeight = mainNav?.offsetHeight || 0;
          const productNavHeight = productNav?.offsetHeight || 0;
          const offset = mainNavHeight + productNavHeight + 20;
          
          const targetPosition = target.getBoundingClientRect().top + window.scrollY - offset;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  }
</script>