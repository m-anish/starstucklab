---
// src/components/ProductNav.astro
// Product-specific sticky navigation bar (appears below main navbar)
import "../styles/components/product-nav.css";

interface Props {
  product: {
    slug: string;
    title: string;
  };
}

const { product } = Astro.props;
---

<nav class="product-nav" id="productNav">
  <div class="product-nav-inner">
    <!-- Product Title Section -->
    <div class="product-brand">
      <span class="product-brand-text">{product.title}</span>
    </div>

    <!-- Product-Specific Links -->
    <div class="product-nav-links">
      <a href="#features" class="product-nav-link">Features</a>
      <a href="#specifications" class="product-nav-link">Specifications</a>
      <a href="#description" class="product-nav-link">Description</a>
    </div>
  </div>
</nav>

<script>
  // Sticky behavior for product nav (appears below main nav)
  if (typeof window !== 'undefined') {
    const productNav = document.getElementById('productNav') as HTMLElement;
    const mainNav = document.querySelector('.site-nav') as HTMLElement;

    if (productNav && mainNav) {
      let mainNavHeight = mainNav.offsetHeight;

      // Recalculate on resize (for orientation changes, etc.)
      const updateNavHeight = () => {
        mainNavHeight = mainNav.offsetHeight;
        document.documentElement.style.setProperty('--main-nav-height', `${mainNavHeight}px`);
        if (productNav.classList.contains('is-sticky')) {
          productNav.style.top = `${mainNavHeight}px`;
        }
      };

      window.addEventListener('resize', updateNavHeight);
      window.addEventListener('orientationchange', updateNavHeight);

      // Initial set
      updateNavHeight();

      // Optimized scroll handler
      let ticking = false;
      const handleScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            // Recalculate mainNavHeight on each scroll for safety
            const currentNavHeight = mainNav.offsetHeight;

            if (window.scrollY > 100) {
              productNav.classList.add('is-sticky');
              productNav.style.top = `${currentNavHeight}px`;
            } else {
              productNav.classList.remove('is-sticky');
              productNav.style.top = '0';
            }
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
    }

    // Smooth scroll to sections
    const links = document.querySelectorAll('.product-nav-link');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.slice(1);
        if (!targetId) return;
        
        const target = document.getElementById(targetId);
        if (target) {
          const mainNavHeight = mainNav?.offsetHeight || 0;
          const productNavHeight = productNav?.offsetHeight || 0;
          const offset = mainNavHeight + productNavHeight + 20;
          
          const targetPosition = target.getBoundingClientRect().top + window.scrollY - offset;
          
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  }
</script>
