---
// src/components/Footer.astro
import { getFooterData } from '../lib/footer';

const footerData = getFooterData();
const sections = footerData.sections;
const settings = footerData.settings;

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

function resolveHref(href: string): string {
  if (!href) return base;
  if (/^(https?:)?\/\//.test(href) || href.startsWith('mailto:') || href.startsWith('#')) return href;
  const trimmed = href.startsWith('/') ? href.slice(1) : href;
  return base + trimmed;
}
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__grid">
      {sections.map((section) => (
        <div class="footer__section">
          <h4 class="footer__heading">{section.title}</h4>

          {section.description && (
            <p class="footer__description">{section.description}</p>
          )}

          {section.links && section.links.length > 0 && (
            <ul class="footer__links">
              {section.links
                .sort((a, b) => (a.order || 999) - (b.order || 999))
                .map((link) => (
                  <li>
                    <a href={resolveHref(link.href)} class="footer__link">{link.label}</a>
                  </li>
                ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="footer__support">
      <span class="footer__support-note">Built on curiosity and caffeine — keep the lab running:</span>
      <a class="support-btn" href="https://buymeachai.ezee.li/anishmg" target="_blank" rel="noopener">☕ Buy me a chai</a>
      <a class="support-btn" href="https://ko-fi.com/P5P7BMO10" target="_blank" rel="noopener">♥ Ko-fi</a>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; {new Date().getFullYear()} {settings.copyrightText}</p>
      <p class="footer__tagline">Built in a small workshop. Aimed at an indifferent sky.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(6, 5, 3, 0.98);
    border-top: 1px solid rgba(201, 185, 122, 0.12);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    margin-top: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .footer__heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .footer__description {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-base);
    max-width: 32ch;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: rgba(237, 237, 238, 0.55);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  .footer__support {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__support-note {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
    margin-right: var(--space-2);
  }

  .support-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 15px;
    border: 1px solid color-mix(in srgb, var(--color-accent, #c9b97a) 45%, transparent);
    border-radius: var(--radius-full, 9999px);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-accent, #c9b97a);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .support-btn:hover {
    background: var(--color-accent, #c9b97a);
    color: #0c0c0e;
    border-color: var(--color-accent, #c9b97a);
  }

  .footer__bottom {
    padding-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  .footer__tagline {
    font-size: var(--text-xs);
    color: var(--color-faint);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 400px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
