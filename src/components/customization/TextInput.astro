---
// src/components/customization/TextInput.astro
import type { CustomizationOption } from '../../lib/pricing';

interface Props {
  option: CustomizationOption;
}

const { option } = Astro.props;
---

<div class="customization-option text-input-option" data-option-id={option.id}>
  <label class="option-label" for={`input-${option.id}`}>
    {option.label}
    {option.help_text && <span class="help-text">{option.help_text}</span>}
  </label>
  
  <input
    type="text"
    id={`input-${option.id}`}
    name={option.id}
    data-option-id={option.id}
    class="customization-input text-input"
    value={option.default}
    placeholder={option.placeholder || ''}
    maxlength={option.max_length}
  />
  
  {option.max_length && (
    <div class="char-counter" aria-live="polite">
      <span class="current-count">0</span> / {option.max_length}
    </div>
  )}
  
  <div class="validation-message" role="alert"></div>
</div>

<style>
  .text-input-option {
    margin-bottom: var(--space-6);
  }
  
  .option-label {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-dark);
    margin-bottom: var(--space-3);
  }
  
  .help-text {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
  
  .text-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 2px solid rgba(80, 50, 25, 0.2);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--ink-dark);
    background: rgba(255, 250, 240, 0.9);
    transition: all var(--transition-fast);
  }
  
  .text-input:hover {
    border-color: rgba(80, 50, 25, 0.3);
  }
  
  .text-input:focus {
    outline: none;
    border-color: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(42, 122, 79, 0.15);
  }
  
  .text-input::placeholder {
    color: var(--ink-muted);
    opacity: 0.6;
  }
  
  .char-counter {
    display: block;
    text-align: right;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-2);
  }
  
  .char-counter .current-count {
    font-weight: 600;
  }
  
  .validation-message {
    font-size: var(--text-xs);
    color: #c44;
    margin-top: var(--space-2);
    min-height: 1.2em;
  }
  
  @media (max-width: 640px) {
    .text-input {
      font-size: 16px; /* Prevent iOS zoom */
    }
  }
</style>

<script>
  import { validateValue } from '../../lib/pricing';
  
  document.querySelectorAll('.text-input').forEach(input => {
    const inputEl = input as HTMLInputElement;
    const optionId = inputEl.dataset.optionId!;
    const option = inputEl.closest('.text-input-option')!;
    const counter = option.querySelector('.current-count');
    const validationMsg = option.querySelector('.validation-message');
    
    // Update character counter
    function updateCounter() {
      if (counter) {
        counter.textContent = inputEl.value.length.toString();
      }
    }
    
    // Validate input
    function validate() {
      if (!validationMsg) return true;
      
      const maxLength = inputEl.maxLength;
      if (maxLength && inputEl.value.length > maxLength) {
        validationMsg.textContent = `Maximum ${maxLength} characters`;
        return false;
      }
      
      validationMsg.textContent = '';
      return true;
    }
    
    // Update on input
    inputEl.addEventListener('input', () => {
      updateCounter();
      validate();
    });
    
    // Validate on change
    inputEl.addEventListener('change', () => {
      if (validate()) {
        // Dispatch for price calculation
        inputEl.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
    
    // Initial update
    updateCounter();
  });
</script>