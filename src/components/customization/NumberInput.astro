---
// src/components/customization/NumberInput.astro
import type { CustomizationOption } from '../../lib/pricing';

interface Props {
  option: CustomizationOption;
}

const { option } = Astro.props;
---

<div class="customization-option number-input-option" data-option-id={option.id}>
  <label class="option-label" for={`input-${option.id}`}>
    {option.label}
    {option.help_text && <span class="help-text">{option.help_text}</span>}
  </label>
  
  <div class="number-input-wrapper">
    <button type="button" class="number-btn decrease" aria-label="Decrease">−</button>
    <input
      type="number"
      id={`input-${option.id}`}
      name={option.id}
      data-option-id={option.id}
      class="customization-input number-input"
      value={option.default}
      min={option.min}
      max={option.max}
      step={option.step || 1}
    />
    <button type="button" class="number-btn increase" aria-label="Increase">+</button>
  </div>
  
  {(option.min !== undefined || option.max !== undefined) && (
    <div class="range-info">
      Range: {option.min ?? '−∞'} to {option.max ?? '∞'}
    </div>
  )}
  
  <div class="validation-message" role="alert"></div>
</div>

<style>
  .number-input-option {
    margin-bottom: var(--space-6);
  }
  
  .option-label {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-dark);
    margin-bottom: var(--space-3);
  }
  
  .help-text {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
  
  .number-input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  
  .number-btn {
    width: 40px;
    height: 40px;
    border: 2px solid rgba(80, 50, 25, 0.2);
    border-radius: var(--radius-md);
    background: rgba(255, 250, 240, 0.9);
    color: var(--ink-dark);
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .number-btn:hover:not(:disabled) {
    border-color: var(--accent-green);
    background: rgba(42, 122, 79, 0.1);
  }
  
  .number-btn:active:not(:disabled) {
    transform: scale(0.95);
  }
  
  .number-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  
  .number-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border: 2px solid rgba(80, 50, 25, 0.2);
    border-radius: var(--radius-lg);
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-dark);
    background: rgba(255, 250, 240, 0.9);
    text-align: center;
    transition: all var(--transition-fast);
  }
  
  .number-input:hover {
    border-color: rgba(80, 50, 25, 0.3);
  }
  
  .number-input:focus {
    outline: none;
    border-color: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(42, 122, 79, 0.15);
  }
  
  /* Hide spinner arrows */
  .number-input::-webkit-inner-spin-button,
  .number-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  .number-input[type=number] {
    -moz-appearance: textfield;
  }
  
  .range-info {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-2);
  }
  
  .validation-message {
    font-size: var(--text-xs);
    color: #c44;
    margin-top: var(--space-2);
    min-height: 1.2em;
  }
</style>

<script>
  document.querySelectorAll('.number-input-option').forEach(option => {
    const input = option.querySelector('.number-input') as HTMLInputElement;
    const decreaseBtn = option.querySelector('.decrease') as HTMLButtonElement;
    const increaseBtn = option.querySelector('.increase') as HTMLButtonElement;
    const validationMsg = option.querySelector('.validation-message');
    
    const min = input.min ? parseFloat(input.min) : -Infinity;
    const max = input.max ? parseFloat(input.max) : Infinity;
    const step = input.step ? parseFloat(input.step) : 1;
    
    function updateButtons() {
      const value = parseFloat(input.value);
      decreaseBtn.disabled = value <= min;
      increaseBtn.disabled = value >= max;
    }
    
    function validate() {
      if (!validationMsg) return true;
      
      const value = parseFloat(input.value);
      
      if (isNaN(value)) {
        validationMsg.textContent = 'Must be a valid number';
        return false;
      }
      
      if (value < min) {
        validationMsg.textContent = `Minimum value is ${min}`;
        return false;
      }
      
      if (value > max) {
        validationMsg.textContent = `Maximum value is ${max}`;
        return false;
      }
      
      validationMsg.textContent = '';
      return true;
    }
    
    decreaseBtn.addEventListener('click', () => {
      const value = parseFloat(input.value);
      const newValue = Math.max(min, value - step);
      input.value = newValue.toString();
      updateButtons();
      validate();
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
    
    increaseBtn.addEventListener('click', () => {
      const value = parseFloat(input.value);
      const newValue = Math.min(max, value + step);
      input.value = newValue.toString();
      updateButtons();
      validate();
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
    
    input.addEventListener('input', () => {
      updateButtons();
      validate();
    });
    
    input.addEventListener('change', () => {
      if (validate()) {
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
    
    // Initial state
    updateButtons();
  });
</script>