---
// src/components/customization/RadioInput.astro
import type { CustomizationOption } from '../../lib/pricing';

interface Props {
  option: CustomizationOption;
}

const { option } = Astro.props;
const options = option.options || [];
---

<div class="customization-option radio-input-option" data-option-id={option.id}>
  <div class="option-label">
    {option.label}
    {option.help_text && <span class="help-text">{option.help_text}</span>}
  </div>
  
  <div class="radio-group" role="radiogroup" aria-label={option.label}>
    {options.map((opt: any) => (
      <label class="radio-label">
        <input
          type="radio"
          name={option.id}
          data-option-id={option.id}
          class="customization-input radio-input"
          value={opt.value}
          checked={opt.value === option.default}
          data-price={opt.price || 0}
        />
        <span class="radio-custom"></span>
        <span class="radio-text">
          {opt.label}
          {opt.price && opt.price > 0 && <span class="price-badge">+{opt.price}</span>}
        </span>
      </label>
    ))}
  </div>
</div>

<style>
  .radio-input-option {
    margin-bottom: var(--space-6);
  }
  
  .option-label {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-dark);
    margin-bottom: var(--space-3);
  }
  
  .help-text {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
  
  .radio-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .radio-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 2px solid rgba(80, 50, 25, 0.2);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .radio-label:hover {
    border-color: rgba(80, 50, 25, 0.3);
    background: rgba(255, 250, 240, 0.5);
  }
  
  .radio-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  
  .radio-custom {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(80, 50, 25, 0.3);
    border-radius: 50%;
    background: rgba(255, 250, 240, 0.9);
    transition: all var(--transition-fast);
    position: relative;
  }
  
  .radio-custom::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-green);
    transition: all var(--transition-fast);
  }
  
  .radio-input:checked + .radio-custom {
    border-color: var(--accent-green);
  }
  
  .radio-input:checked + .radio-custom::after {
    transform: translate(-50%, -50%) scale(1);
  }
  
  .radio-input:checked ~ .radio-text {
    font-weight: 600;
  }
  
  .radio-input:focus-visible + .radio-custom {
    outline: 2px solid var(--accent-green);
    outline-offset: 2px;
  }
  
  .radio-label:has(.radio-input:checked) {
    border-color: var(--accent-green);
    background: rgba(42, 122, 79, 0.05);
  }
  
  .radio-text {
    flex: 1;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink-dark);
    line-height: 1.5;
  }
  
  .price-badge {
    display: inline-block;
    margin-left: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background: rgba(42, 122, 79, 0.1);
    color: var(--accent-green);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }
</style>

<script>
  document.querySelectorAll('.radio-input').forEach(radio => {
    radio.addEventListener('change', () => {
      // Dispatch for price calculation
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
</script>