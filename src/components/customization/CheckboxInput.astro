---
// src/components/customization/CheckboxInput.astro
import type { CustomizationOption } from '../../lib/pricing';

interface Props {
  option: CustomizationOption;
}

const { option } = Astro.props;
---

<div class="customization-option checkbox-input-option" data-option-id={option.id}>
  <label class="checkbox-label">
    <input
      type="checkbox"
      id={`input-${option.id}`}
      name={option.id}
      data-option-id={option.id}
      class="customization-input checkbox-input"
      checked={option.default}
    />
    <span class="checkbox-custom"></span>
    <span class="checkbox-text">
      {option.label}
      {option.help_text && <span class="help-text">{option.help_text}</span>}
    </span>
  </label>
</div>

<style>
  .checkbox-input-option {
    margin-bottom: var(--space-6);
  }
  
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
    user-select: none;
  }
  
  .checkbox-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  
  .checkbox-custom {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 2px solid rgba(80, 50, 25, 0.3);
    border-radius: var(--radius-md);
    background: rgba(255, 250, 240, 0.9);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  
  .checkbox-custom::after {
    content: '✓';
    color: white;
    font-size: 16px;
    font-weight: 700;
    opacity: 0;
    transform: scale(0);
    transition: all var(--transition-fast);
  }
  
  .checkbox-input:checked + .checkbox-custom {
    background: var(--accent-green);
    border-color: var(--accent-green);
  }
  
  .checkbox-input:checked + .checkbox-custom::after {
    opacity: 1;
    transform: scale(1);
  }
  
  .checkbox-input:focus-visible + .checkbox-custom {
    outline: 2px solid var(--accent-green);
    outline-offset: 2px;
  }
  
  .checkbox-label:hover .checkbox-custom {
    border-color: var(--accent-green);
  }
  
  .checkbox-text {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--ink-dark);
    line-height: 1.5;
  }
  
  .help-text {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
</style>

<script>
  document.querySelectorAll('.checkbox-input').forEach(checkbox => {
    checkbox.addEventListener('change', () => {
      // Dispatch for price calculation
      checkbox.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
</script>
