---
// src/components/customization/SelectInput.astro
import type { CustomizationOption } from '../../lib/pricing';

interface Props {
  option: CustomizationOption;
}

const { option } = Astro.props;
const options = option.options || [];
---

<div class="customization-option select-input-option" data-option-id={option.id}>
  <label class="option-label" for={`input-${option.id}`}>
    {option.label}
    {option.help_text && <span class="help-text">{option.help_text}</span>}
  </label>
  
  <div class="select-wrapper">
    <select
      id={`input-${option.id}`}
      name={option.id}
      data-option-id={option.id}
      class="customization-input select-input"
    >
      {options.map((opt: any) => (
        <option 
          value={opt.value}
          selected={opt.value === option.default}
          data-price={opt.price || 0}
        >
          {opt.label}
          {opt.price && opt.price > 0 && ` (+${opt.price})`}
        </option>
      ))}
    </select>
    <span class="select-arrow" aria-hidden="true">▼</span>
  </div>
</div>

<style>
  .select-input-option {
    margin-bottom: var(--space-6);
  }
  
  .option-label {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-dark);
    margin-bottom: var(--space-3);
  }
  
  .help-text {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }
  
  .select-wrapper {
    position: relative;
  }
  
  .select-input {
    width: 100%;
    padding: var(--space-3) var(--space-10) var(--space-3) var(--space-4);
    border: 2px solid rgba(80, 50, 25, 0.2);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--ink-dark);
    background: rgba(255, 250, 240, 0.9);
    cursor: pointer;
    transition: all var(--transition-fast);
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }
  
  .select-input:hover {
    border-color: rgba(80, 50, 25, 0.3);
  }
  
  .select-input:focus {
    outline: none;
    border-color: var(--accent-green);
    box-shadow: 0 0 0 3px rgba(42, 122, 79, 0.15);
  }
  
  .select-arrow {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--ink-mid);
    font-size: 0.7rem;
    transition: transform var(--transition-fast);
  }
  
  .select-input:focus + .select-arrow {
    transform: translateY(-50%) rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll('.select-input').forEach(select => {
    select.addEventListener('change', () => {
      // Dispatch for price calculation
      select.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
</script>