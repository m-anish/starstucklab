---
// FeaturedSections.astro — homepage below-hero "constellation preview".
// Sources from the machines registry (not the shop) and reuses MachineCard so
// it stays consistent with /machines. Shows one machine per kind to tell the
// breadth story (a telescope, a machine, a piece of software).
import { getMachines } from '../lib/machines';
import MachineCard from './MachineCard.astro';
import '../styles/components/featured-sections.css';

const machines = getMachines();
const kinds = ['telescope', 'hardware', 'software'] as const;
const preview = kinds
  .map((k) => machines.find((m) => m.kind === k && m.access !== 'soon'))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<div class="featured-sections-wrap">
  {preview.length > 0 ? (
    <section class="featured-section" id="featured-machines">
      <div class="section-header">
        <p class="section-tag">From the bench</p>
        <h2>Small machines, attempting usefulness.</h2>
        <p class="section-lead">
          Each one started as a sketch on the back of an envelope and ended
          somewhere between hardware and confession — a telescope, a box that
          argues with lightning, an almanac for the night sky.
        </p>
      </div>

      <div class="featured-grid">
        {preview.map((machine) => <MachineCard machine={machine} />)}
      </div>

      <div class="section-footer">
        <a href="/machines" class="section-cta">
          See all the machines <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  ) : (
    <section class="featured-section">
      <p class="fs-empty">The workshop is currently between projects. Check back soon.</p>
    </section>
  )}
</div>

<style>
/* Header copy for the constellation preview. The grid/section/cta layout comes
   from featured-sections.css; the cards style themselves (MachineCard). */
.section-tag {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(248, 244, 232, 0.55);
  font-weight: 600;
  margin: 0 0 14px;
}

.section-lead {
  font-family: 'Merriweather', Georgia, serif;
  font-weight: 300;
  color: rgba(248, 244, 232, 0.78);
  max-width: 52ch;
  margin-inline: auto;
  font-size: 17px;
  line-height: 1.55;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85);
}

.fs-empty {
  font-family: 'Crimson Pro', Georgia, serif;
  font-style: italic;
  color: rgba(248, 244, 232, 0.55);
  text-align: center;
  padding: 60px 20px;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}
</style>
