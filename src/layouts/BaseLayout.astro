---
// site/src/layouts/BaseLayout.astro
// Minimal base layout - just HTML shell, meta tags, fonts
// All page layouts should extend this
import '../styles/tokens.css';
import '../styles/global.css';
import FaviconHead from "../components/FaviconHead.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

interface Props {
  title?: string;
  description?: string;
  class?: string;
}

const {
  title = 'Starstuck Lab',
  description = 'Where science met poetry and regretted nothing.',
  class: className = ''
} = Astro.props;

const base = (Astro.site?.pathname || '/').replace(/\/?$/, '/');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FaviconHead />
    <GoogleAnalytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}assets/icons/starstucklab_logo_black_white.svg`} />
    <!-- Playfair Display (display/heading) + Merriweather (body/lead) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Merriweather:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class={className}>
    <slot />
  </body>
</html>