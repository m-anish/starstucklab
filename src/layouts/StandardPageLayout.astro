// site/src/layouts/StandardPageLayout.astro
// Standard layout for shop, contact, privacy, legal pages
// Includes: static navbar, content area, footer and optional scene background

import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SceneBackground from "../components/SceneBackground.astro";
import CartDrawer from "../components/CartDrawer.astro";
import "../styles/components/navbar.css";
import "../styles/components/footer.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  /** optional scene key to render a background picture from /assets manifest (e.g. "shop") */
  backgroundScene?: string;
}

const { title, description, pageClass = '', backgroundScene = '' } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  <nav class="site-nav nav-static" role="navigation">
    <Navbar />
  </nav>

  <!-- Background stage (render only when a backgroundScene is present in the manifest) -->
  {backgroundScene ? (
    <div class="page-stage page-stage--with-bg">
      <SceneBackground sceneKey={backgroundScene} />
      <main class={`page-content ${pageClass}`}>
        <slot />
      </main>
    </div>
  ) : (
    // If no scene requested / found, just render normal structure
    <main class={`page-content ${pageClass}`}>
      <slot />
    </main>
  )}

  <Footer />
  
  <CartDrawer />
</BaseLayout>

<style>
  .page-content {
    min-height: 100vh;
    padding-top: 64px; /* Account for fixed navbar */
    position: relative;
    z-index: 2;
  }

  .page-stage {
    position: relative;
    overflow: visible;
  }

  /* ensure content sits above bg */
  .page-stage--with-bg .page-content {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 820px) {
    .page-content {
      padding-top: 56px;
    }
  }
</style>
